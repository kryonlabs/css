#import "css_parser"

using CssTokenKind;

// One-way conversion of a KSS sheet to Kryon CSS, for files and for saved
// user sheets. It rewrites structure, not meaning: tokens become :root
// custom properties, themes and environment blocks become media queries,
// '@layer name;' sections become '@layer name { }' blocks, and KSS property
// names and bare token references become their CSS forms. The result is
// formatted with two-space indentation. A construct with no CSS form (such
// as @variant) is an error naming its line; nothing is guessed.

CssMigration :: struct {
    ok: bool
    count: s32
    line: s32
    error: [160]u8
    error_length: s32
}

CssMigrateKind :: struct {
    name: CssName
    kind: s32
}

CssMigrator :: struct {
    source: string
    pos: s32
    line: s32
    output: []u8
    count: s32
    overflow: bool
    indent: s32
    line_start: bool
    // Token kinds from the sheet's own tokens blocks.
    kinds: [256]CssMigrateKind
    kind_count: s32
    // Inside an auto-wrapped '@layer name {' from a KSS '@layer name;'.
    layer_open: bool
    failed: bool
    error: [160]u8
    error_length: s32
    error_line: s32
    // A blank line goes between top-level items.
    items: s32
}

css_migrator: CssMigrator;

// Rule declarations collected before they are written.
CssMigrateDeclaration :: struct {
    property: [40]u8
    property_length: s32
    value: [256]u8
    value_length: s32
}

CssMigrateRule :: struct {
    items: [64]CssMigrateDeclaration
    count: s32
    background: s32
    background_end: s32
    offset_x: s32
    offset_y: s32
}

css_migrate_rule: CssMigrateRule;

CssMigrateFail :: (m: *CssMigrator, message: string) {
    if m.failed { return }
    m.failed = true
    m.error_line = m.line
    count: s32 = cast(s32)message.count
    if count > 160 { count = 160 }
    for index: cast(s32)0..count - 1 { m.error[index] = message[index] }
    m.error_length = count
}

// Output ------------------------------------------------------------------

CssMigrateRaw :: (m: *CssMigrator, text: string) {
    for index: cast(s32)0..cast(s32)text.count - 1 {
        if m.count >= cast(s32)m.output.count {
            m.overflow = true
            return
        }
        m.output[m.count] = text[index]
        m.count += 1
    }
}

CssMigrateWrite :: (m: *CssMigrator, text: string) {
    if text.count == 0 { return }
    if m.line_start {
        for level: cast(s32)0..m.indent - 1 { CssMigrateRaw(m, "  ") }
        m.line_start = false
    }
    CssMigrateRaw(m, text)
}

CssMigrateNewline :: (m: *CssMigrator) {
    CssMigrateRaw(m, "\n")
    m.line_start = true
}

CssMigrateBlank :: (m: *CssMigrator) {
    if m.count > 0 && m.count >= 2 && !(m.output[m.count - 1] == 10 && m.output[m.count - 2] == 10) &&
        !(m.output[m.count - 1] == 10 && m.output[m.count - 2] == #char "{") {
        CssMigrateNewline(m)
    }
}

CssMigrateOpen :: (m: *CssMigrator, head: string) {
    CssMigrateWrite(m, head)
    CssMigrateWrite(m, " {")
    CssMigrateNewline(m)
    m.indent += 1
}

CssMigrateClose :: (m: *CssMigrator) {
    m.indent -= 1
    CssMigrateWrite(m, "}")
    CssMigrateNewline(m)
}

// Input ---------------------------------------------------------------------

CssMigrateAtEnd :: (m: *CssMigrator) -> bool {
    return m.pos >= cast(s32)m.source.count
}

CssMigratePeek :: (m: *CssMigrator, ahead: s32) -> u8 {
    at: s32 = m.pos + ahead
    if at < 0 || at >= cast(s32)m.source.count { return 0 }
    return m.source[at]
}

CssMigrateAdvance :: (m: *CssMigrator) {
    if m.pos < cast(s32)m.source.count {
        if m.source[m.pos] == 10 { m.line += 1 }
        m.pos += 1
    }
}

// Skip spaces; comments are copied as /* */ lines when `keep` is set.
CssMigrateSpace :: (m: *CssMigrator, keep: bool) {
    while !CssMigrateAtEnd(m) {
        byte: u8 = CssMigratePeek(m, 0)
        if CssIsSpace(byte) {
            CssMigrateAdvance(m)
            continue
        }
        if byte == #char "/" && CssMigratePeek(m, 1) == #char "/" {
            start: s32 = m.pos + 2
            while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != 10 { CssMigrateAdvance(m) }
            if keep { CssMigrateComment(m, m.source[start:m.pos]) }
            continue
        }
        if byte == #char "/" && CssMigratePeek(m, 1) == #char "*" {
            CssMigrateAdvance(m)
            CssMigrateAdvance(m)
            start: s32 = m.pos
            while !CssMigrateAtEnd(m) && !(CssMigratePeek(m, 0) == #char "*" && CssMigratePeek(m, 1) == #char "/") {
                CssMigrateAdvance(m)
            }
            if CssMigrateAtEnd(m) {
                CssMigrateFail(m, "unterminated comment")
                return
            }
            if keep { CssMigrateComment(m, m.source[start:m.pos]) }
            CssMigrateAdvance(m)
            CssMigrateAdvance(m)
            continue
        }
        return
    }
}

CssMigrateComment :: (m: *CssMigrator, text: string) {
    start: s32 = 0
    end: s32 = cast(s32)text.count
    while start < end && CssIsSpace(text[start]) { start += 1 }
    while end > start && CssIsSpace(text[end - 1]) { end -= 1 }
    if !m.line_start { CssMigrateNewline(m) }
    CssMigrateWrite(m, "/* ")
    // '*/' inside a line comment would end the CSS comment early.
    for index: start..end - 1 {
        if text[index] == #char "*" && index + 1 < end && text[index + 1] == #char "/" {
            CssMigrateWrite(m, "* ")
        } else {
            byte: [1]u8
            byte[0] = text[index]
            CssMigrateWrite(m, TextView(byte[:]))
        }
    }
    CssMigrateWrite(m, " */")
    CssMigrateNewline(m)
}

CssMigrateNameChar :: (byte: u8) -> bool {
    return CssIsAlpha(byte) || CssIsDigit(byte) || byte == #char "_" || byte == #char "-" ||
        byte == #char "." || byte >= 128
}

CssMigrateName :: (m: *CssMigrator) -> string {
    start: s32 = m.pos
    while !CssMigrateAtEnd(m) && CssMigrateNameChar(CssMigratePeek(m, 0)) { CssMigrateAdvance(m) }
    return m.source[start:m.pos]
}

CssMigrateExpect :: (m: *CssMigrator, byte: u8, message: string) -> bool {
    CssMigrateSpace(m, false)
    if CssMigratePeek(m, 0) != byte {
        CssMigrateFail(m, message)
        return false
    }
    CssMigrateAdvance(m)
    return true
}

// A value up to ';' or '}' outside quotes and parentheses, trimmed.
CssMigrateValue :: (m: *CssMigrator) -> string {
    CssMigrateSpace(m, false)
    start: s32 = m.pos
    depth: s32 = 0
    quote: u8 = 0
    while !CssMigrateAtEnd(m) {
        byte: u8 = CssMigratePeek(m, 0)
        if quote != 0 {
            if byte == quote { quote = 0 }
        } else if byte == #char "\"" || byte == #char "'" {
            quote = byte
        } else if byte == #char "(" {
            depth += 1
        } else if byte == #char ")" {
            depth -= 1
        } else if depth <= 0 && (byte == #char ";" || byte == #char "}") {
            break
        }
        CssMigrateAdvance(m)
    }
    end: s32 = m.pos
    while end > start && CssIsSpace(m.source[end - 1]) { end -= 1 }
    if CssMigratePeek(m, 0) == #char ";" { CssMigrateAdvance(m) }
    return m.source[start:end]
}

// Token kinds and names --------------------------------------------------

CssMigrateKindOf :: (m: *CssMigrator, name: string) -> s32 {
    for index: cast(s32)0..m.kind_count - 1 {
        if CssNameEquals(m.kinds[index].name, name) { return m.kinds[index].kind }
    }
    return -1
}

CssMigrateIsColor :: (m: *CssMigrator, name: string) -> bool {
    for index: cast(s32)0..m.kind_count - 1 {
        if m.kinds[index].kind == cast(s32)CssTokenColor && CssNameEquals(m.kinds[index].name, name) {
            return true
        }
    }
    return false
}

CssMigrateRecordKind :: (m: *CssMigrator, name: string, kind: s32) {
    for index: cast(s32)0..m.kind_count - 1 {
        if m.kinds[index].kind == kind && CssNameEquals(m.kinds[index].name, name) { return }
    }
    if m.kind_count >= 256 { return }
    m.kinds[m.kind_count].name = CssMakeName(name)
    m.kinds[m.kind_count].kind = kind
    m.kind_count += 1
}

// '--name' for a KSS token of `kind`. KSS kept one name space per kind; CSS
// has one, so a non-color token sharing a color token's name gets a suffix.
// The shipped packs define both a color and a length named 'border'.
CssMigrateWriteProperty :: (m: *CssMigrator, name: string, kind: s32, out: *CssMigrateText) {
    CssMigrateTextAdd(out, "--")
    for index: cast(s32)0..cast(s32)name.count - 1 {
        byte: [1]u8
        byte[0] = ifx name[index] == #char "." then cast(u8)45 else name[index]
        CssMigrateTextAdd(out, TextView(byte[:]))
    }
    if kind != cast(s32)CssTokenColor && (CssMigrateIsColor(m, name) || CssNameEquals(CssMakeName(name), "border")) {
        if kind == cast(s32)CssTokenMaterial { CssMigrateTextAdd(out, "-material") }
        else if kind == cast(s32)CssTokenDuration { CssMigrateTextAdd(out, "-duration") }
        else { CssMigrateTextAdd(out, "-size") }
    }
}

CssMigrateText :: struct {
    bytes: [256]u8
    length: s32
    overflow: bool
}

CssMigrateTextAdd :: (text: *CssMigrateText, value: string) {
    for index: cast(s32)0..cast(s32)value.count - 1 {
        if text.length >= 256 {
            text.overflow = true
            return
        }
        text.bytes[text.length] = value[index]
        text.length += 1
    }
}

CssMigrateIsNumber :: (value: string) -> bool {
    if value.count == 0 { return false }
    start: s32 = 0
    if value[0] == #char "-" || value[0] == #char "+" { start = 1 }
    if start >= cast(s32)value.count { return false }
    digits: s32 = 0
    for index: start..cast(s32)value.count - 1 {
        byte: u8 = value[index]
        if CssIsDigit(byte) { digits += 1 }
        else if byte != #char "." { return false }
    }
    return digits > 0
}

CssMigrateIsZero :: (value: string) -> bool {
    for index: cast(s32)0..cast(s32)value.count - 1 {
        byte: u8 = value[index]
        if byte != #char "0" && byte != #char "." && byte != #char "-" && byte != #char "+" { return false }
    }
    return true
}

// One value word of a known kind: literal or bare token reference.
CssMigrateTyped :: (m: *CssMigrator, value: string, kind: s32, out: *CssMigrateText) {
    if value.count == 0 {
        CssMigrateFail(m, "expected a value")
        return
    }
    if kind == cast(s32)CssTokenColor {
        if value[0] == #char "#" || CssAtColorText(value) {
            CssMigrateTextAdd(out, value)
            return
        }
        known: bool = CssMigrateIsColor(m, value)
        if !known && (CssNameEquals(CssMakeName(value), "transparent") ||
            CssNameEquals(CssMakeName(value), "black") || CssNameEquals(CssMakeName(value), "white")) {
            CssMigrateTextAdd(out, value)
            return
        }
        CssMigrateTextAdd(out, "var(")
        CssMigrateWriteProperty(m, value, kind, out)
        CssMigrateTextAdd(out, ")")
        return
    }
    if kind == cast(s32)CssTokenMaterial {
        if CssMaterialValue(CssMakeName(value)) >= 0 {
            for index: cast(s32)0..cast(s32)value.count - 1 {
                byte: [1]u8
                byte[0] = CssLower(value[index])
                CssMigrateTextAdd(out, TextView(byte[:]))
            }
            return
        }
        CssMigrateTextAdd(out, "var(")
        CssMigrateWriteProperty(m, value, kind, out)
        CssMigrateTextAdd(out, ")")
        return
    }
    if CssMigrateIsNumber(value) {
        CssMigrateTextAdd(out, value)
        if kind == cast(s32)CssTokenLength && !CssMigrateIsZero(value) { CssMigrateTextAdd(out, "px") }
        return
    }
    if CssIsDigit(value[0]) || value[0] == #char "." || value[0] == #char "-" {
        // Already has a unit: '8px', '0.14s'.
        CssMigrateTextAdd(out, value)
        return
    }
    reference: s32 = kind
    known: s32 = CssMigrateKindOf(m, value)
    if kind == cast(s32)CssTokenNumber || kind == cast(s32)CssTokenLength {
        // KSS numeric properties read length or duration tokens.
        if known == cast(s32)CssTokenDuration { reference = known }
        else { reference = cast(s32)CssTokenLength }
    }
    CssMigrateTextAdd(out, "var(")
    CssMigrateWriteProperty(m, value, reference, out)
    CssMigrateTextAdd(out, ")")
}

CssAtColorText :: (value: string) -> bool {
    if value.count < 4 { return false }
    head: CssName = CssMakeName(value[0:3])
    return (CssNameEquals(head, "rgb") || CssNameEquals(head, "hsl")) &&
        (value[3] == #char "(" || (value.count > 4 && value[4] == #char "("))
}

// Rules -------------------------------------------------------------------

CssMigrateKssProperty :: (name: string) -> s32 {
    // 0 color, 1 length, 4 number, 3 material, 7 typeface, -1 other.
    lowered: CssName = CssMakeName(name)
    if CssNameEquals(lowered, "background") || CssNameEquals(lowered, "foreground") ||
        CssNameEquals(lowered, "border") || CssNameEquals(lowered, "focus") ||
        CssNameEquals(lowered, "background-end") {
        return cast(s32)CssTokenColor
    }
    if CssNameEquals(lowered, "opacity") { return cast(s32)CssTokenNumber }
    if CssNameEquals(lowered, "material") { return cast(s32)CssTokenMaterial }
    if CssNameEquals(lowered, "typeface") { return 7 }
    for text: css_migrate_lengths {
        if CssNameEquals(lowered, text) { return cast(s32)CssTokenLength }
    }
    return -1
}

css_migrate_lengths: [12]string = .[
    "radius", "border-width", "padding-x", "padding-y", "gap", "font-size",
    "icon-size", "offset-x", "offset-y", "letter-spacing", "width", "height"];

CssMigrateCssProperty :: (name: string) -> string {
    lowered: CssName = CssMakeName(name)
    if CssNameEquals(lowered, "foreground") { return "color" }
    if CssNameEquals(lowered, "border") { return "border-color" }
    if CssNameEquals(lowered, "focus") { return "outline-color" }
    if CssNameEquals(lowered, "radius") { return "border-radius" }
    if CssNameEquals(lowered, "padding-x") { return "padding-inline" }
    if CssNameEquals(lowered, "padding-y") { return "padding-block" }
    if CssNameEquals(lowered, "margin-x") { return "margin-inline" }
    if CssNameEquals(lowered, "margin-y") { return "margin-block" }
    if CssNameEquals(lowered, "icon-size") { return "-kryon-icon-size" }
    if CssNameEquals(lowered, "material") { return "-kryon-material" }
    if CssNameEquals(lowered, "typeface") { return "font-family" }
    return name
}

// Web document properties whose bare numbers are px.
CssMigrateWebLength :: (name: string) -> bool {
    for text: css_migrate_web_lengths {
        if CssNameEquals(CssMakeName(name), text) { return true }
    }
    return false
}

css_migrate_web_lengths: [16]string = .[
    "width", "height", "min-width", "min-height", "max-width", "max-height", "margin",
    "margin-x", "margin-y", "margin-top", "margin-right", "margin-bottom", "margin-left",
    "margin-inline", "margin-block", "line-height"];

CssMigrateAddDeclaration :: (rule: *CssMigrateRule, property: string, value: *CssMigrateText) -> s32 {
    if rule.count >= 64 { return -1 }
    item: *CssMigrateDeclaration = *rule.items[rule.count]
    count: s32 = cast(s32)property.count
    if count > 40 { count = 40 }
    for index: cast(s32)0..count - 1 { item.property[index] = property[index] }
    item.property_length = count
    for index: cast(s32)0..value.length - 1 { item.value[index] = value.bytes[index] }
    item.value_length = value.length
    rule.count += 1
    return rule.count - 1
}

// One declaration 'name: value;' inside a rule.
CssMigrateDeclarationItem :: (m: *CssMigrator, rule: *CssMigrateRule) {
    name: string = CssMigrateName(m)
    if name.count == 0 {
        CssMigrateFail(m, "expected a property name")
        return
    }
    if !CssMigrateExpect(m, #char ":", "expected ':' after the property name") { return }
    value: string = CssMigrateValue(m)
    if m.failed { return }
    kind: s32 = CssMigrateKssProperty(name)
    text: CssMigrateText
    if kind == 7 {
        if value.count > 0 && (value[0] == #char "\"" || value[0] == #char "'") {
            CssMigrateTextAdd(*text, value)
        } else {
            CssMigrateTextAdd(*text, "\"")
            CssMigrateTextAdd(*text, value)
            CssMigrateTextAdd(*text, "\"")
        }
    } else if kind >= 0 && !(CssNameEquals(CssMakeName(name), "width") || CssNameEquals(CssMakeName(name), "height")) {
        CssMigrateTyped(m, value, kind, *text)
    } else if name.count >= 2 && name[0] == #char "-" && name[1] == #char "-" {
        CssMigrateTextAdd(*text, value)
    } else {
        // Web document properties: bare lengths gain px, token words become var().
        at: s32 = 0
        first: bool = true
        while at < cast(s32)value.count {
            while at < cast(s32)value.count && CssIsSpace(value[at]) { at += 1 }
            if at >= cast(s32)value.count { break }
            start: s32 = at
            depth: s32 = 0
            while at < cast(s32)value.count && (depth > 0 || !CssIsSpace(value[at])) {
                if value[at] == #char "(" { depth += 1 }
                if value[at] == #char ")" { depth -= 1 }
                at += 1
            }
            word: string = value[start:at]
            if !first { CssMigrateTextAdd(*text, " ") }
            first = false
            if CssMigrateWebLength(name) && CssMigrateIsNumber(word) {
                CssMigrateTextAdd(*text, word)
                if !CssMigrateIsZero(word) { CssMigrateTextAdd(*text, "px") }
            } else if CssMigrateKindOf(m, word) >= 0 {
                CssMigrateTyped(m, word, CssMigrateKindOf(m, word), *text)
            } else {
                CssMigrateTextAdd(*text, word)
            }
        }
    }
    if text.overflow {
        CssMigrateFail(m, "value longer than 256 bytes")
        return
    }
    lowered: CssName = CssMakeName(name)
    index: s32 = CssMigrateAddDeclaration(rule, CssMigrateCssProperty(name), *text)
    if index < 0 {
        CssMigrateFail(m, "more than 64 declarations in one rule")
        return
    }
    if CssNameEquals(lowered, "background") { rule.background = index }
    if CssNameEquals(lowered, "background-end") { rule.background_end = index }
    if CssNameEquals(lowered, "offset-x") { rule.offset_x = index }
    if CssNameEquals(lowered, "offset-y") { rule.offset_y = index }
}

CssMigrateWriteValue :: (m: *CssMigrator, rule: *CssMigrateRule, index: s32) {
    CssMigrateWrite(m, TextView(rule.items[index].value[:rule.items[index].value_length]))
}

// Write the collected declarations, combining KSS pairs into CSS shorthands.
CssMigrateWriteRule :: (m: *CssMigrator, rule: *CssMigrateRule) {
    if rule.background_end >= 0 && rule.background < 0 {
        CssMigrateFail(m, "background-end needs a background in the same rule")
        return
    }
    for index: cast(s32)0..rule.count - 1 {
        if index == rule.background_end || (index == rule.offset_y && rule.offset_x >= 0) { continue }
        item: *CssMigrateDeclaration = *rule.items[index]
        if index == rule.background && rule.background_end >= 0 {
            CssMigrateWrite(m, "background: linear-gradient(")
            CssMigrateWriteValue(m, rule, index)
            CssMigrateWrite(m, ", ")
            CssMigrateWriteValue(m, rule, rule.background_end)
            CssMigrateWrite(m, ");")
        } else if index == rule.offset_x || index == rule.offset_y {
            CssMigrateWrite(m, "translate: ")
            if rule.offset_x >= 0 { CssMigrateWriteValue(m, rule, rule.offset_x) }
            else { CssMigrateWrite(m, "0") }
            CssMigrateWrite(m, " ")
            if rule.offset_y >= 0 { CssMigrateWriteValue(m, rule, rule.offset_y) }
            else { CssMigrateWrite(m, "0") }
            CssMigrateWrite(m, ";")
        } else {
            CssMigrateWrite(m, TextView(item.property[:item.property_length]))
            CssMigrateWrite(m, ": ")
            CssMigrateWriteValue(m, rule, index)
            CssMigrateWrite(m, ";")
        }
        CssMigrateNewline(m)
    }
}

// A selector: KSS states and kinds renamed to CSS.
CssMigrateSelector :: (m: *CssMigrator, text: string, out: *CssMigrateText) {
    at: s32 = 0
    while at < cast(s32)text.count {
        byte: u8 = text[at]
        if byte == #char ":" {
            at += 1
            start: s32 = at
            while at < cast(s32)text.count && CssMigrateNameChar(text[at]) { at += 1 }
            state: CssName = CssMakeName(text[start:at])
            if CssNameEquals(state, "normal") || CssNameEquals(state, "any") { continue }
            CssMigrateTextAdd(out, ":")
            if CssNameEquals(state, "pressed") || CssNameEquals(state, "press") {
                CssMigrateTextAdd(out, "active")
            } else if CssNameEquals(state, "focused") {
                CssMigrateTextAdd(out, "focus")
            } else {
                CssMigrateTextAdd(out, text[start:at])
            }
            continue
        }
        if byte == #char "[" {
            close: s32 = at
            while close < cast(s32)text.count && text[close] != #char "]" { close += 1 }
            inner: string = text[at + 1:close]
            if inner.count > 6 && CssNameEquals(CssMakeName(inner[0:6]), "class=") {
                CssMigrateTextAdd(out, ".")
                CssMigrateTextAdd(out, inner[6:inner.count])
            } else {
                CssMigrateTextAdd(out, text[at:close + 1])
            }
            at = close + 1
            continue
        }
        if CssIsAlpha(byte) && (at == 0 || text[at - 1] == #char " " || text[at - 1] == #char ",") {
            start: s32 = at
            while at < cast(s32)text.count && CssMigrateNameChar(text[at]) { at += 1 }
            word: string = text[start:at]
            if CssNameEquals(CssMakeName(word), "Any") { CssMigrateTextAdd(out, "*") }
            else { CssMigrateTextAdd(out, word) }
            continue
        }
        if CssIsSpace(byte) {
            // Normalize list spacing: 'A,B' and 'A ,  B' become 'A, B'.
            while at < cast(s32)text.count && CssIsSpace(text[at]) { at += 1 }
            if at < cast(s32)text.count && text[at] != #char "," && out.length > 0 &&
                out.bytes[out.length - 1] != #char " " {
                CssMigrateTextAdd(out, " ")
            }
            continue
        }
        single: [1]u8
        single[0] = byte
        CssMigrateTextAdd(out, TextView(single[:]))
        if byte == #char "," { CssMigrateTextAdd(out, " ") }
        at += 1
    }
}

// A rule with the cursor on its selector.
CssMigrateStyleRule :: (m: *CssMigrator) {
    start: s32 = m.pos
    while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != #char "{" {
        if CssMigratePeek(m, 0) == #char ";" || CssMigratePeek(m, 0) == #char "}" {
            CssMigrateFail(m, "expected '{' after the selector")
            return
        }
        CssMigrateAdvance(m)
    }
    if CssMigrateAtEnd(m) {
        CssMigrateFail(m, "expected '{' after the selector")
        return
    }
    end: s32 = m.pos
    while end > start && CssIsSpace(m.source[end - 1]) { end -= 1 }
    selector: CssMigrateText
    CssMigrateSelector(m, m.source[start:end], *selector)
    CssMigrateAdvance(m)
    rule: *CssMigrateRule = *css_migrate_rule
    rule.count = 0
    rule.background = -1
    rule.background_end = -1
    rule.offset_x = -1
    rule.offset_y = -1
    CssMigrateOpen(m, TextView(selector.bytes[:selector.length]))
    while true {
        CssMigrateSpace(m, false)
        if m.failed { return }
        if CssMigrateAtEnd(m) {
            CssMigrateFail(m, "expected '}' to close the rule")
            return
        }
        if CssMigratePeek(m, 0) == #char "}" {
            CssMigrateAdvance(m)
            break
        }
        if CssMigratePeek(m, 0) == #char ";" {
            CssMigrateAdvance(m)
            continue
        }
        CssMigrateDeclarationItem(m, rule)
        if m.failed { return }
    }
    CssMigrateWriteRule(m, rule)
    CssMigrateClose(m)
}

// tokens { color { ... } length { ... } } with the cursor after 'tokens'.
CssMigrateTokens :: (m: *CssMigrator) {
    if !CssMigrateExpect(m, #char "{", "expected '{' after tokens") { return }
    CssMigrateOpen(m, ":root")
    while true {
        CssMigrateSpace(m, true)
        if m.failed { return }
        if CssMigratePeek(m, 0) == #char "}" {
            CssMigrateAdvance(m)
            break
        }
        group: string = CssMigrateName(m)
        kind: s32 = -1
        lowered: CssName = CssMakeName(group)
        if CssNameEquals(lowered, "color") { kind = cast(s32)CssTokenColor }
        else if CssNameEquals(lowered, "length") { kind = cast(s32)CssTokenLength }
        else if CssNameEquals(lowered, "material") { kind = cast(s32)CssTokenMaterial }
        else if CssNameEquals(lowered, "duration") { kind = cast(s32)CssTokenDuration }
        if kind < 0 {
            CssMigrateFail(m, "expected color, length, duration or material in tokens")
            return
        }
        if !CssMigrateExpect(m, #char "{", "expected '{' after the token kind") { return }
        CssMigrateDefinitions(m, kind)
        if m.failed { return }
    }
    CssMigrateClose(m)
}

// 'name: value;' token definitions up to '}', of one kind or (kind -1)
// inferred from the value or the sheet's earlier tokens.
CssMigrateDefinitions :: (m: *CssMigrator, kind: s32) {
    while true {
        CssMigrateSpace(m, true)
        if m.failed { return }
        if CssMigrateAtEnd(m) {
            CssMigrateFail(m, "expected '}'")
            return
        }
        if CssMigratePeek(m, 0) == #char "}" {
            CssMigrateAdvance(m)
            return
        }
        name: string = CssMigrateName(m)
        if name.count == 0 {
            CssMigrateFail(m, "expected a token name")
            return
        }
        if CssNameEquals(CssMakeName(name), "tokens") {
            CssMigrateSpace(m, false)
            if CssMigratePeek(m, 0) == #char "{" {
                CssMigrateFail(m, "tokens inside a theme are not supported by css-migrate")
                return
            }
        }
        if !CssMigrateExpect(m, #char ":", "expected ':' after the token name") { return }
        value: string = CssMigrateValue(m)
        if m.failed { return }
        token_kind: s32 = kind
        if token_kind < 0 {
            token_kind = CssMigrateKindOf(m, name)
            if token_kind < 0 {
                if value.count > 0 && value[0] == #char "#" { token_kind = cast(s32)CssTokenColor }
                else if CssMigrateIsNumber(value) { token_kind = cast(s32)CssTokenLength }
                else if CssMaterialValue(CssMakeName(value)) >= 0 { token_kind = cast(s32)CssTokenMaterial }
                else { token_kind = cast(s32)CssTokenColor }
            }
        }
        CssMigrateRecordKind(m, name, token_kind)
        text: CssMigrateText
        CssMigrateWriteProperty(m, name, token_kind, *text)
        CssMigrateTextAdd(*text, ": ")
        CssMigrateTyped(m, value, token_kind, *text)
        CssMigrateTextAdd(*text, ";")
        if m.failed { return }
        CssMigrateWrite(m, TextView(text.bytes[:text.length]))
        CssMigrateNewline(m)
    }
}

CssMigrateEndLayer :: (m: *CssMigrator) {
    if m.layer_open {
        CssMigrateClose(m)
        m.layer_open = false
    }
}

// Items up to '}' (nested) or the end (top level).
CssMigrateItems :: (m: *CssMigrator, nested: bool) {
    while true {
        CssMigrateSpace(m, true)
        if m.failed { return }
        if CssMigrateAtEnd(m) {
            if nested { CssMigrateFail(m, "expected '}'") }
            return
        }
        byte: u8 = CssMigratePeek(m, 0)
        if byte == #char "}" {
            if !nested {
                CssMigrateFail(m, "unexpected '}'")
                return
            }
            CssMigrateAdvance(m)
            return
        }
        if !nested { CssMigrateBlank(m) }
        if byte == #char "@" {
            CssMigrateAdvance(m)
            CssMigrateDirective(m, nested)
        } else {
            saved: s32 = m.pos
            saved_line: s32 = m.line
            word: string = CssMigrateName(m)
            CssMigrateSpace(m, false)
            if CssNameEquals(CssMakeName(word), "tokens") && CssMigratePeek(m, 0) == #char "{" {
                CssMigrateTokens(m)
            } else {
                m.pos = saved
                m.line = saved_line
                CssMigrateStyleRule(m)
            }
        }
        if m.failed { return }
    }
}

CssMigrateSkipStatement :: (m: *CssMigrator) {
    while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != #char ";" { CssMigrateAdvance(m) }
    if !CssMigrateAtEnd(m) { CssMigrateAdvance(m) }
}

CssMigrateDirective :: (m: *CssMigrator, nested: bool) {
    keyword: string = CssMigrateName(m)
    lowered: CssName = CssMakeName(keyword)
    if CssNameEquals(lowered, "pack") || CssNameEquals(lowered, "version") {
        CssMigrateSkipStatement(m)
        return
    }
    if CssNameEquals(lowered, "import") {
        CssMigrateSpace(m, false)
        target: string
        if CssMigratePeek(m, 0) == #char "<" {
            CssMigrateAdvance(m)
            start: s32 = m.pos
            while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != #char ">" { CssMigrateAdvance(m) }
            target = m.source[start:m.pos]
            CssMigrateAdvance(m)
        } else if CssMigratePeek(m, 0) == #char "\"" || CssMigratePeek(m, 0) == #char "'" {
            quote: u8 = CssMigratePeek(m, 0)
            CssMigrateAdvance(m)
            start: s32 = m.pos
            while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != quote { CssMigrateAdvance(m) }
            target = m.source[start:m.pos]
            CssMigrateAdvance(m)
        } else {
            CssMigrateFail(m, "expected an import target")
            return
        }
        if !CssMigrateExpect(m, #char ";", "expected ';' after @import") { return }
        CssMigrateWrite(m, "@import \"")
        CssMigrateWrite(m, target)
        CssMigrateWrite(m, "\";")
        CssMigrateNewline(m)
        return
    }
    if CssNameEquals(lowered, "layer") {
        CssMigrateSpace(m, false)
        first: string = CssMigrateName(m)
        CssMigrateSpace(m, false)
        if CssMigratePeek(m, 0) == #char "," {
            CssMigrateWrite(m, "@layer ")
            CssMigrateWrite(m, first)
            while CssMigratePeek(m, 0) == #char "," {
                CssMigrateAdvance(m)
                CssMigrateSpace(m, false)
                CssMigrateWrite(m, ", ")
                CssMigrateWrite(m, CssMigrateName(m))
                CssMigrateSpace(m, false)
            }
            if !CssMigrateExpect(m, #char ";", "expected ';' after the layer list") { return }
            CssMigrateWrite(m, ";")
            CssMigrateNewline(m)
            return
        }
        if !CssMigrateExpect(m, #char ";", "expected ';' after the layer name") { return }
        if nested {
            CssMigrateFail(m, "'@layer name;' inside a block has no CSS form")
            return
        }
        // KSS: following rules belong to this layer.
        CssMigrateEndLayer(m)
        CssMigrateBlank(m)
        head: CssMigrateText
        CssMigrateTextAdd(*head, "@layer ")
        CssMigrateTextAdd(*head, first)
        CssMigrateOpen(m, TextView(head.bytes[:head.length]))
        m.layer_open = true
        return
    }
    if CssNameEquals(lowered, "theme") {
        CssMigrateSpace(m, false)
        name: string = CssMigrateName(m)
        if !CssMigrateExpect(m, #char "{", "expected '{' after the theme name") { return }
        head: CssMigrateText
        if CssNameEquals(CssMakeName(name), "dark") || CssNameEquals(CssMakeName(name), "light") {
            CssMigrateTextAdd(*head, "@media (prefers-color-scheme: ")
            CssMigrateTextAdd(*head, name)
            CssMigrateTextAdd(*head, ")")
        } else {
            CssMigrateTextAdd(*head, "@media (-kryon-theme: ")
            CssMigrateTextAdd(*head, name)
            CssMigrateTextAdd(*head, ")")
        }
        CssMigrateOpen(m, TextView(head.bytes[:head.length]))
        CssMigrateOpen(m, ":root")
        CssMigrateDefinitions(m, -1)
        if m.failed { return }
        CssMigrateClose(m)
        CssMigrateClose(m)
        return
    }
    if CssNameEquals(lowered, "env") {
        CssMigrateSpace(m, false)
        axis: CssName = CssMakeName(CssMigrateName(m))
        if !CssMigrateExpect(m, #char "(", "expected '(' after the environment axis") { return }
        CssMigrateSpace(m, false)
        value: string = CssMigrateName(m)
        if !CssMigrateExpect(m, #char ")", "expected ')'") { return }
        if !CssMigrateExpect(m, #char "{", "expected '{'") { return }
        head: CssMigrateText
        CssMigrateTextAdd(*head, "@media (")
        if CssNameEquals(axis, "contrast") {
            CssMigrateTextAdd(*head, "prefers-contrast: ")
            if CssNameEquals(CssMakeName(value), "high") { CssMigrateTextAdd(*head, "more") }
            else { CssMigrateTextAdd(*head, "no-preference") }
        } else if CssNameEquals(axis, "density") || CssNameEquals(axis, "pointer") ||
            CssNameEquals(axis, "platform") {
            CssMigrateTextAdd(*head, "-kryon-")
            CssMigrateTextAdd(*head, TextView(axis.bytes[:axis.length]))
            CssMigrateTextAdd(*head, ": ")
            CssMigrateTextAdd(*head, value)
        } else if CssNameEquals(axis, "theme") {
            if CssNameEquals(CssMakeName(value), "dark") || CssNameEquals(CssMakeName(value), "light") {
                CssMigrateTextAdd(*head, "prefers-color-scheme: ")
            } else {
                CssMigrateTextAdd(*head, "-kryon-theme: ")
            }
            CssMigrateTextAdd(*head, value)
        } else {
            CssMigrateFail(m, "unknown @env axis")
            return
        }
        CssMigrateTextAdd(*head, ")")
        CssMigrateOpen(m, TextView(head.bytes[:head.length]))
        CssMigrateItems(m, true)
        if m.failed { return }
        CssMigrateClose(m)
        return
    }
    if CssNameEquals(lowered, "media") || CssNameEquals(lowered, "keyframes") {
        CssMigrateSpace(m, false)
        start: s32 = m.pos
        while !CssMigrateAtEnd(m) && CssMigratePeek(m, 0) != #char "{" { CssMigrateAdvance(m) }
        end: s32 = m.pos
        while end > start && CssIsSpace(m.source[end - 1]) { end -= 1 }
        if !CssMigrateExpect(m, #char "{", "expected '{'") { return }
        head: CssMigrateText
        CssMigrateTextAdd(*head, "@")
        CssMigrateTextAdd(*head, keyword)
        CssMigrateTextAdd(*head, " ")
        CssMigrateTextAdd(*head, m.source[start:end])
        CssMigrateOpen(m, TextView(head.bytes[:head.length]))
        CssMigrateItems(m, true)
        if m.failed { return }
        CssMigrateClose(m)
        return
    }
    if CssNameEquals(lowered, "variant") {
        CssMigrateFail(m, "@variant has no CSS form; express it as a class or a media query")
        return
    }
    CssMigrateFail(m, "unknown KSS directive")
}

CssMigratePass :: (m: *CssMigrator, source: string, output: []u8) {
    m.source = source
    m.pos = 0
    m.line = 1
    m.output = output
    m.count = 0
    m.overflow = false
    m.indent = 0
    m.line_start = true
    m.layer_open = false
    m.failed = false
    m.error_length = 0
    CssMigrateItems(m, false)
    if !m.failed { CssMigrateEndLayer(m) }
}

// Convert KSS `source` to Kryon CSS in `output`.
#program_export
CssMigrateKss :: (source: string, output: []u8) -> CssMigration {
    result: CssMigration
    m: *CssMigrator = *css_migrator
    m.kind_count = 0
    // The first pass learns every token's kind; the second writes.
    empty: [1]u8
    CssMigratePass(m, source, empty[:0])
    if !m.failed { CssMigratePass(m, source, output) }
    if m.failed {
        result.line = m.error_line
        for index: cast(s32)0..m.error_length - 1 { result.error[index] = m.error[index] }
        result.error_length = m.error_length
        return result
    }
    if m.overflow {
        message: string = "the converted sheet does not fit the output"
        for index: cast(s32)0..cast(s32)message.count - 1 { result.error[index] = message[index] }
        result.error_length = cast(s32)message.count
        return result
    }
    result.ok = true
    result.count = m.count
    return result
}
