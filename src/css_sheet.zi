#import "css_parser"
#import "kryon/style"
#import "kryon/style_sheet"
#import "kryon/drawing_props"
#import "kryon/control_props"
Theme :: #import "kryon/theme";
Binary :: #import "std/binary";

using CssStatus;
using CssTokenKind;
using CssValueKind;
using CssField;
using StyleField;
using LineHeightUnit;

// A sheet is what every host installs: the rules of one or more parsed or
// compiled sources, each with its media condition, their var() references,
// and the custom property definitions. Installing evaluates the conditions
// for one environment, picks each custom property's final value, fills the
// references and replaces Kryon's style table in one step. A failed install
// leaves the previous style untouched.

CssSheetRuleCapacity :: 1024
CssSheetRefCapacity :: 4096
CssSheetExprCapacity :: 512
CssSheetDefinitionCapacity :: 768
CssSheetConditionCapacity :: 64
CssSheetTypefaceCapacity :: 16
CssSheetKeyframesCapacity :: 128
CssSheetFrameCapacity :: 2048

CssSheetRule :: struct {
    rule: StyleRule
    motion: CssRuleMotion
    // Index into conditions, or -1 for always.
    condition: s32
}

// A field of a rule whose length follows the viewport.
CssSheetExpr :: struct {
    rule: s32
    field: s32
    expr: CssLengthExpr
}

CssSheetRef :: struct {
    rule: s32
    name: s32
    field: s32
    fallback: bool
    // The nested var() fallback's name + 1, else 0.
    alternate: s32
    file: s32
    line: s32
}

CssSheetDefinition :: struct {
    name: s32
    condition: s32
    kind: s32
    color: u32
    number: float32
    material: s32
    alias: s32
    file: s32
    line: s32
}

CssSheetKeyframes :: struct {
    key: u64
    layer: s32
    condition: s32
    first: s32
    count: s32
    unsupported: bool
}

// Host values that replace custom properties whatever the sheet says, such
// as a system palette. Names are without '--'.
CssOverrides :: struct {
    tokens: [128]CssToken
    count: s32
}

CssSheet :: struct {
    rules: [CssSheetRuleCapacity]CssSheetRule
    rule_count: s32
    refs: [CssSheetRefCapacity]CssSheetRef
    ref_count: s32
    exprs: [CssSheetExprCapacity]CssSheetExpr
    expr_count: s32
    definitions: [CssSheetDefinitionCapacity]CssSheetDefinition
    definition_count: s32
    conditions: [CssSheetConditionCapacity]CssCondition
    condition_count: s32
    names: [CssNameCapacity]CssName
    name_count: s32
    themes: [CssThemeCapacity]CssName
    theme_count: s32
    layers: [12]CssName
    layer_count: s32
    files: [16]CssSourceFile
    file_count: s32
    // Final custom property values of the last resolve, by name index.
    final: [CssNameCapacity]CssToken
    keyframes: [CssSheetKeyframesCapacity]CssSheetKeyframes
    keyframes_count: s32
    frames: [CssSheetFrameCapacity]CssKeyframe
    frame_count: s32
    // Count of rules or keyframes blocks containing browser-only motion.
    motion_unsupported: s32
    diagnostic: [256]u8
    diagnostic_length: s32
    failed: bool
}

CssSheetResult :: struct {
    ok: bool
    rules: s32
}

#program_export
CssSheetReset :: (sheet: *CssSheet) {
    sheet.rule_count = 0
    sheet.ref_count = 0
    sheet.expr_count = 0
    sheet.definition_count = 0
    sheet.condition_count = 0
    sheet.name_count = 0
    sheet.theme_count = 0
    sheet.layer_count = 0
    sheet.file_count = 0
    sheet.keyframes_count = 0
    sheet.frame_count = 0
    sheet.motion_unsupported = 0
    sheet.diagnostic_length = 0
    sheet.failed = false
}

CssSheetAppend :: (sheet: *CssSheet, text: string) {
    for index: cast(s32)0..cast(s32)text.count - 1 {
        if sheet.diagnostic_length >= 255 { return }
        sheet.diagnostic[sheet.diagnostic_length] = text[index]
        sheet.diagnostic_length += 1
    }
}

CssSheetAppendInt :: (sheet: *CssSheet, value: s32) {
    digits: [12]u8
    count: s32 = 0
    remaining: s32 = value
    if remaining <= 0 {
        CssSheetAppend(sheet, "0")
        return
    }
    while remaining > 0 && count < 12 {
        digits[count] = cast(u8)(48 + remaining % 10)
        remaining = remaining / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        if sheet.diagnostic_length < 255 {
            sheet.diagnostic[sheet.diagnostic_length] = digits[count]
            sheet.diagnostic_length += 1
        }
    }
}

CssSheetFail :: (sheet: *CssSheet, message: string) {
    if sheet.failed { return }
    sheet.failed = true
    sheet.diagnostic_length = 0
    CssSheetAppend(sheet, message)
}

// "message '--name' at file:line".
CssSheetFailAt :: (sheet: *CssSheet, message: string, name: s32, file: s32, line: s32) {
    if sheet.failed { return }
    sheet.failed = true
    sheet.diagnostic_length = 0
    CssSheetAppend(sheet, message)
    if name >= 0 && name < sheet.name_count {
        CssSheetAppend(sheet, " '--")
        CssSheetAppend(sheet, TextView(sheet.names[name].bytes[:sheet.names[name].length]))
        CssSheetAppend(sheet, "'")
    }
    if line > 0 {
        CssSheetAppend(sheet, " at ")
        if file >= 0 && file < sheet.file_count {
            CssSheetAppend(sheet, TextView(sheet.files[file].name[:sheet.files[file].length]))
            CssSheetAppend(sheet, ":")
        }
        CssSheetAppendInt(sheet, line)
    }
}

#program_export
CssSheetDiagnostic :: (sheet: *CssSheet, output: []u8) -> string {
    count: s32 = sheet.diagnostic_length
    if count > cast(s32)output.count { count = cast(s32)output.count }
    for index: cast(s32)0..count - 1 { output[index] = sheet.diagnostic[index] }
    return TextView(output[:count])
}

CssSheetName :: (sheet: *CssSheet, name: CssName) -> s32 {
    for index: cast(s32)0..sheet.name_count - 1 {
        if CssNameSame(sheet.names[index], name) { return index }
    }
    if sheet.name_count >= CssNameCapacity {
        CssSheetFail(sheet, "more than 256 custom properties")
        return -1
    }
    sheet.names[sheet.name_count] = name
    sheet.name_count += 1
    return sheet.name_count - 1
}

CssSheetTheme :: (sheet: *CssSheet, name: CssName) -> s32 {
    for index: cast(s32)0..sheet.theme_count - 1 {
        if CssNameEqualsName(sheet.themes[index], name) { return index }
    }
    if sheet.theme_count >= CssThemeCapacity {
        CssSheetFail(sheet, "more than 32 -kryon-theme names")
        return -1
    }
    sheet.themes[sheet.theme_count] = name
    sheet.theme_count += 1
    return sheet.theme_count - 1
}

CssSheetLayer :: (sheet: *CssSheet, name: CssName) -> s32 {
    for index: cast(s32)0..sheet.layer_count - 1 {
        if CssNameEqualsName(sheet.layers[index], name) { return index }
    }
    if sheet.layer_count >= 12 {
        CssSheetFail(sheet, "more than 12 layers")
        return -1
    }
    sheet.layers[sheet.layer_count] = name
    sheet.layer_count += 1
    return sheet.layer_count - 1
}

CssSheetFile :: (sheet: *CssSheet, file: CssSourceFile) -> s32 {
    for index: cast(s32)0..sheet.file_count - 1 {
        if TextView(sheet.files[index].name[:sheet.files[index].length]) ==
            TextView(file.name[:file.length]) {
            return index
        }
    }
    if sheet.file_count >= 16 { return -1 }
    sheet.files[sheet.file_count] = file
    sheet.file_count += 1
    return sheet.file_count - 1
}

CssConditionSame :: (a: *CssCondition, b: *CssCondition) -> bool {
    if a.count != b.count || a.never != b.never { return false }
    for index: cast(s32)0..a.count - 1 {
        if a.branches[index].mask != b.branches[index].mask ||
            a.branches[index].theme != b.branches[index].theme ||
            a.branches[index].viewport_count != b.branches[index].viewport_count ||
            a.branches[index].width_count != b.branches[index].width_count ||
            a.branches[index].min_width != b.branches[index].min_width ||
            a.branches[index].max_width != b.branches[index].max_width {
            return false
        }
    }
    return true
}

// In native sheets the typed viewport bounds outlive the source spans.
CssSheetCondition :: (sheet: *CssSheet, p: *CssParser, condition: CssCondition) -> s32 {
    if condition.count == 0 && !condition.never { return -1 }
    mapped: CssCondition = condition
    for index: cast(s32)0..mapped.count - 1 {
        theme: s32 = mapped.branches[index].theme
        if theme >= 0 { mapped.branches[index].theme = CssSheetTheme(sheet, p.themes[theme]) }
        for span: cast(s32)0..3 {
            mapped.branches[index].viewport[span].start = 0
            mapped.branches[index].viewport[span].length = 0
        }
    }
    for index: cast(s32)0..sheet.condition_count - 1 {
        if CssConditionSame(*sheet.conditions[index], *mapped) { return index }
    }
    if sheet.condition_count >= CssSheetConditionCapacity {
        CssSheetFail(sheet, "more than 64 distinct media conditions")
        return -1
    }
    sheet.conditions[sheet.condition_count] = mapped
    sheet.condition_count += 1
    return sheet.condition_count - 1
}

// Take the rule, custom property or keyframes block the parser just yielded.
#program_export
CssSheetTake :: (sheet: *CssSheet, p: *CssParser) {
    if sheet.failed { return }
    // Layers rank in the order the parser met them, '@layer a, b;' included,
    // not in the order their first rule arrives.
    for index: cast(s32)0..p.layer_count - 1 { unused CssSheetLayer(sheet, p.layer_names[index]) }
    if sheet.failed { return }
    file: s32 = CssSheetFile(sheet, p.files[p.cursor.file])
    if p.status == cast(s32)CssStatusProperty {
        if sheet.definition_count >= CssSheetDefinitionCapacity {
            CssSheetFail(sheet, "more than 768 custom property definitions")
            return
        }
        definition: CssSheetDefinition
        definition.name = CssSheetName(sheet, p.definition.name)
        definition.condition = CssSheetCondition(sheet, p, p.rule_condition)
        definition.kind = p.definition.kind
        definition.color = p.definition.color
        definition.number = p.definition.number
        definition.material = p.definition.material
        definition.alias = -1
        if p.definition.alias >= 0 { definition.alias = CssSheetName(sheet, p.names[p.definition.alias]) }
        definition.file = file
        definition.line = p.definition.line
        if sheet.failed { return }
        sheet.definitions[sheet.definition_count] = definition
        sheet.definition_count += 1
        return
    }
    if p.status == cast(s32)CssStatusKeyframes {
        if sheet.keyframes_count >= CssSheetKeyframesCapacity ||
            sheet.frame_count + p.keyframes.count > CssSheetFrameCapacity {
            CssSheetFail(sheet, "the CSS keyframes table is full")
            return
        }
        entry: CssSheetKeyframes
        entry.key = p.keyframes.key
        entry.layer = p.layer_of_rule
        if entry.layer != CssLayerUnlayered {
            entry.layer = CssSheetLayer(sheet, p.layer_names[entry.layer])
        }
        entry.condition = CssSheetCondition(sheet, p, p.rule_condition)
        entry.first = sheet.frame_count
        entry.count = p.keyframes.count
        entry.unsupported = p.keyframes.unsupported
        if sheet.failed { return }
        for index: cast(s32)0..entry.count - 1 {
            sheet.frames[sheet.frame_count] = p.keyframes.frames[index]
            sheet.frame_count += 1
        }
        sheet.keyframes[sheet.keyframes_count] = entry
        sheet.keyframes_count += 1
        if entry.unsupported { sheet.motion_unsupported += 1 }
        return
    }
    if p.status != cast(s32)CssStatusRule { return }
    if sheet.rule_count >= CssSheetRuleCapacity {
        CssSheetFail(sheet, "more than 1024 rules in one sheet")
        return
    }
    if sheet.ref_count + p.rule_ref_count > CssSheetRefCapacity {
        CssSheetFail(sheet, "more than 4096 var() references in one sheet")
        return
    }
    if sheet.expr_count + p.rule_expr_count > CssSheetExprCapacity {
        CssSheetFail(sheet, "more than 512 viewport lengths in one sheet")
        return
    }
    entry: CssSheetRule
    entry.rule = p.rule
    entry.motion = p.motion
    entry.rule.order = sheet.rule_count
    if p.rule.layer != CssLayerUnlayered {
        entry.rule.layer = CssSheetLayer(sheet, p.layer_names[p.rule.layer])
    }
    entry.condition = CssSheetCondition(sheet, p, p.rule_condition)
    if sheet.failed { return }
    for index: cast(s32)0..p.rule_ref_count - 1 {
        ref: CssSheetRef
        ref.rule = sheet.rule_count
        ref.name = CssSheetName(sheet, p.names[p.rule_refs[index].token])
        ref.field = p.rule_refs[index].field
        ref.fallback = p.rule_refs[index].fallback
        alternate := p.rule_refs[index].alternate
        if alternate > 0 { ref.alternate = CssSheetName(sheet, p.names[alternate - 1]) + 1 }
        ref.file = file
        ref.line = p.rule_refs[index].line
        sheet.refs[sheet.ref_count] = ref
        sheet.ref_count += 1
    }
    for index: cast(s32)0..p.rule_expr_count - 1 {
        sheet.exprs[sheet.expr_count] = .{.rule = sheet.rule_count, .field = p.rule_exprs[index].field,
            .expr = p.rule_exprs[index].expr}
        sheet.expr_count += 1
    }
    if p.motion.transition.unsupported || p.motion.animation.unsupported { sheet.motion_unsupported += 1 }
    sheet.rules[sheet.rule_count] = entry
    sheet.rule_count += 1
}

// Parse a whole source into the sheet. Imports go through `resolve`; hosts
// without imports pass CssNoImports.
CssImportResolver :: #type (name: string) -> CssImportAnswer;

CssImportAnswer :: struct {
    found: bool
    source: string
}

#program_export
CssNoImports :: (name: string) -> CssImportAnswer {
    answer: CssImportAnswer
    return answer
}

css_sheet_parser: CssParser;

#program_export
CssSheetParse :: (sheet: *CssSheet, source: string, path: string, resolve: CssImportResolver) -> bool {
    return CssSheetParseSource(sheet, source, path, resolve, CssDiagnostics.{}, false)
}

// Collect source issues through a caller-supplied sink. In lenient mode a
// recoverable rejected item is skipped and the supported rules remain usable.
// A strict native check still scans the whole source before it fails.
#program_export
CssSheetParseWithDiagnostics :: (sheet: *CssSheet, source: string, path: string,
    resolve: CssImportResolver, diagnostics: CssDiagnostics) -> bool {
    return CssSheetParseSource(sheet, source, path, resolve, diagnostics, true)
}

CssSheetParseSource :: (sheet: *CssSheet, source: string, path: string, resolve: CssImportResolver,
    diagnostics: CssDiagnostics, collect: bool) -> bool {
    if sheet.failed { return false }
    p: *CssParser = *css_sheet_parser
    CssBegin(p, source, path)
    p.diagnostics = diagnostics
    p.collect_issues = collect
    p.native_only = !collect
    p.report_path = path
    while true {
        status: s32 = CssStep(p)
        if status == cast(s32)CssStatusRule || status == cast(s32)CssStatusProperty ||
            status == cast(s32)CssStatusKeyframes {
            CssSheetTake(sheet, p)
            if sheet.failed {
                if CssCollectIssues(p) {
                    CssReportIssue(p, p.cursor, CssIssueKind.Stylesheet, "",
                        TextView(sheet.diagnostic[:sheet.diagnostic_length]), false)
                }
                return false
            }
        } else if status == cast(s32)CssStatusNeedImport {
            target: [64]u8
            name: string = CssPendingImport(p, target[:])
            answer: CssImportAnswer = resolve(name)
            if answer.found { CssProvideImport(p, answer.source, name) }
            else { CssFailImport(p) }
            if CssFailed(p) && CssCollectIssues(p) {
                CssReportFailure(p, p.statement_origin, CssIssueKind.AtRule, "@import")
                CssClearFailure(p)
            }
        } else if status == cast(s32)CssStatusDone {
            if diagnostics.strict && p.issue_count > 0 {
                CssSheetFail(sheet, "stylesheet has native CSS diagnostics")
                return false
            }
            return true
        } else if status == cast(s32)CssStatusError {
            if CssCollectIssues(p) {
                CssReportFailure(p, p.diagnostic_cursor, CssIssueKind.Stylesheet, "")
            }
            sheet.failed = true
            sheet.diagnostic_length = 0
            for index: cast(s32)0..p.diagnostic_length - 1 {
                sheet.diagnostic[index] = p.diagnostic[index]
            }
            sheet.diagnostic_length = p.diagnostic_length
            return false
        }
    }
    return false
}

// Overrides -------------------------------------------------------------

#program_export
CssOverrideColor :: (overrides: *CssOverrides, name: string, color: u32) {
    token: CssToken
    token.name = CssMakeName(CssBareText(name))
    token.kind = cast(s32)CssTokenColor
    token.color = color
    CssOverride(overrides, token)
}

#program_export
CssOverrideLength :: (overrides: *CssOverrides, name: string, pixels: float32) {
    token: CssToken
    token.name = CssMakeName(CssBareText(name))
    token.kind = cast(s32)CssTokenLength
    token.number = pixels
    CssOverride(overrides, token)
}

// A later override of a name replaces the earlier one. Returns false when
// the table is full.
#program_export
CssOverride :: (overrides: *CssOverrides, token: CssToken) -> bool {
    for index: cast(s32)0..overrides.count - 1 {
        if CssNameSame(overrides.tokens[index].name, token.name) {
            overrides.tokens[index] = token
            return true
        }
    }
    if overrides.count >= 128 { return false }
    overrides.tokens[overrides.count] = token
    overrides.count += 1
    return true
}

CssBareText :: (name: string) -> string {
    if name.count >= 2 && name[0] == #char "-" && name[1] == #char "-" { return name[2:name.count] }
    return name
}

// Resolution ------------------------------------------------------------

CssSheetConditionHolds :: (sheet: *CssSheet, condition: s32, env: CssEnvironment) -> bool {
    if condition < 0 { return true }
    return CssConditionMatches(*sheet.conditions[condition], env, sheet.themes[:sheet.theme_count], false)
}

// Compare active branches without rebuilding rules or resolving custom properties.
// Use after a successful install when the sheet and overrides are unchanged.
#program_export
CssSheetSameMedia :: (sheet: *CssSheet, previous: CssEnvironment, next: CssEnvironment) -> bool {
    // A viewport length of an active rule must also come out the same.
    old_width, old_height := CssEnvironmentViewport(previous)
    new_width, new_height := CssEnvironmentViewport(next)
    for index: cast(s32)0..sheet.expr_count - 1 {
        entry := sheet.exprs[index]
        if !CssSheetConditionHolds(sheet, sheet.rules[entry.rule].condition, previous) { continue }
        if CssExprAt(entry.expr, old_width, old_height) != CssExprAt(entry.expr, new_width, new_height) {
            return false
        }
    }
    for index: cast(s32)0..sheet.condition_count - 1 {
        if CssSheetConditionHolds(sheet, index, previous) != CssSheetConditionHolds(sheet, index, next) {
            return false
        }
    }
    return true
}

// Each custom property's value for `env`: the last definition whose
// condition holds, then host overrides, then aliases followed.
#program_export
CssSheetResolve :: (sheet: *CssSheet, env: CssEnvironment, overrides: *CssOverrides) -> bool {
    if sheet.failed { return false }
    for index: cast(s32)0..sheet.name_count - 1 {
        sheet.final[index] = CssToken.{}
        sheet.final[index].name = sheet.names[index]
        sheet.final[index].kind = cast(s32)CssTokenUndefined
        sheet.final[index].alias = -1
    }
    for index: cast(s32)0..sheet.definition_count - 1 {
        definition: CssSheetDefinition = sheet.definitions[index]
        if !CssSheetConditionHolds(sheet, definition.condition, env) { continue }
        token: *CssToken = *sheet.final[definition.name]
        token.kind = definition.kind
        token.color = definition.color
        token.number = definition.number
        token.material = definition.material
        token.alias = definition.alias
        token.file = definition.file
        token.line = definition.line
    }
    if overrides != null {
        for index: cast(s32)0..overrides.count - 1 {
            name: s32 = -1
            for candidate: cast(s32)0..sheet.name_count - 1 {
                if CssNameSame(sheet.names[candidate], overrides.tokens[index].name) { name = candidate }
            }
            if name < 0 { continue }
            token: *CssToken = *sheet.final[name]
            token.kind = overrides.tokens[index].kind
            token.color = overrides.tokens[index].color
            token.number = overrides.tokens[index].number
            token.material = overrides.tokens[index].material
            token.alias = -1
        }
    }
    for index: cast(s32)0..sheet.name_count - 1 {
        hops: s32 = 0
        while sheet.final[index].kind == cast(s32)CssTokenAlias {
            target: s32 = sheet.final[index].alias
            if hops >= 16 {
                CssSheetFailAt(sheet, "var() alias cycle through", index, sheet.final[index].file,
                    sheet.final[index].line)
                return false
            }
            if target == index {
                message: string = ifx hops == 0 then "custom property refers to itself:" else "var() alias cycle through"
                CssSheetFailAt(sheet, message, index, sheet.final[index].file, sheet.final[index].line)
                return false
            }
            next: CssToken = sheet.final[target]
            sheet.final[index].kind = next.kind
            sheet.final[index].color = next.color
            sheet.final[index].number = next.number
            sheet.final[index].material = next.material
            sheet.final[index].alias = next.alias
            hops += 1
        }
    }
    return true
}

CssKindName :: (kind: s32) -> string {
    if kind == cast(s32)CssTokenColor { return "a color" }
    if kind == cast(s32)CssTokenLength { return "a length" }
    if kind == cast(s32)CssTokenDuration { return "a duration" }
    if kind == cast(s32)CssTokenMaterial { return "a material" }
    if kind == cast(s32)CssTokenNumber { return "a number" }
    if kind == cast(s32)CssTokenPercentage { return "a percentage" }
    if kind == cast(s32)CssTokenNormal { return "normal" }
    if kind == cast(s32)CssTokenBold { return "bold" }
    if kind == cast(s32)CssTokenFontStyle { return "a font style" }
    if kind == cast(s32)CssTokenFontRole { return "a font role" }
    if kind == cast(s32)CssTokenElevation { return "an elevation" }
    if kind == cast(s32)CssTokenEasing { return "a motion easing" }
    if kind == cast(s32)CssTokenMotionReduced { return "a reduced-motion value" }
    if kind == cast(s32)CssTokenInherit { return "inherit" }
    return "undefined"
}

// Does a custom property of `kind` fit a field? Zero serves as a length.
CssTokenFits :: (token: CssToken, field: s32) -> bool {
    expected: s32 = CssFieldKind(field)
    if expected == cast(s32)CssValueColor { return token.kind == cast(s32)CssTokenColor }
    if expected == cast(s32)CssValueMaterial { return token.kind == cast(s32)CssTokenMaterial }
    if expected == cast(s32)CssValueNumber {
        return token.kind == cast(s32)CssTokenNumber || token.kind == cast(s32)CssTokenPercentage
    }
    if expected == cast(s32)CssValueFontWeight {
        return token.kind == cast(s32)CssTokenNumber || token.kind == cast(s32)CssTokenNormal ||
            token.kind == cast(s32)CssTokenBold
    }
    if expected == cast(s32)CssValueFontStyle {
        return token.kind == cast(s32)CssTokenFontStyle || token.kind == cast(s32)CssTokenNormal
    }
    if expected == cast(s32)CssValueLineHeight {
        return token.kind == cast(s32)CssTokenNumber || token.kind == cast(s32)CssTokenLength ||
            token.kind == cast(s32)CssTokenPercentage || token.kind == cast(s32)CssTokenNormal
    }
    if expected == cast(s32)CssValueDuration { return token.kind == cast(s32)CssTokenDuration }
    if expected == cast(s32)CssValueFontRole {
        return token.kind == cast(s32)CssTokenFontRole || token.kind == cast(s32)CssTokenInherit
    }
    if expected == cast(s32)CssValueElevation { return token.kind == cast(s32)CssTokenElevation }
    if expected == cast(s32)CssValueEasing {
        return token.kind == cast(s32)CssTokenEasing || token.kind == cast(s32)CssTokenInherit
    }
    if expected == cast(s32)CssValueMotionReduced {
        return token.kind == cast(s32)CssTokenMotionReduced
    }
    return ((expected == cast(s32)CssValueGap || expected == cast(s32)CssValueLetterSpacing) &&
        token.kind == cast(s32)CssTokenNormal) || token.kind == cast(s32)CssTokenLength ||
        (token.kind == cast(s32)CssTokenNumber && token.number == 0.0)
}

CssStyleSetToken :: (style: *StyleData, box: *StyleBoxData, field: s32, token: CssToken) {
    number: float32 = token.number
    material: s32 = token.material
    if field == cast(s32)CssFieldLineHeight {
        if token.kind == cast(s32)CssTokenNormal { material = cast(s32)LineHeightNormal }
        else if token.kind == cast(s32)CssTokenLength { material = cast(s32)LineHeightLength }
        else { material = cast(s32)LineHeightFactor }
    } else if field == cast(s32)CssFieldFontWeight {
        if token.kind == cast(s32)CssTokenNormal { number = 400.0 }
        else if token.kind == cast(s32)CssTokenBold { number = 700.0 }
    }
    CssStyleSet(style, box, field, token.color, number, material)
}

css_install_rules: StyleRules;

// The rules that apply for `env`, references filled, into `rules`.
#program_export
// The token a var() reads: its custom property, else the nested fallback's,
// else a Kryon theme color for a `--kryon-NAME` the sheet leaves undefined.
CssSheetRefToken :: (sheet: *CssSheet, entry: CssSheetRef) -> CssToken {
    token: CssToken = sheet.final[entry.name]
    if token.kind == cast(s32)CssTokenUndefined && entry.alternate > 0 {
        token = sheet.final[entry.alternate - 1]
    }
    if token.kind != cast(s32)CssTokenUndefined { return token }
    names: [2]s32 = .[entry.name, entry.alternate - 1]
    for name: names {
        if name < 0 { continue }
        theme := CssThemeToken(sheet.names[name])
        if theme.kind != cast(s32)CssTokenUndefined { return theme }
    }
    return token
}

// The installed Kryon theme's palette as --kryon-NAME colors.
css_theme_tokens: [16]string = .["background", "surface", "raised", "sunken", "text", "muted",
    "disabled", "border", "border-strong", "accent", "accent-strong", "selection", "selection-text",
    "success", "warning", "danger"];

CssThemeColor :: (index: s32) -> u32 {
    if index == 0 { return Theme.CurrentBackground() }
    if index == 1 { return Theme.CurrentSurface() }
    if index == 2 { return Theme.CurrentRaised() }
    if index == 3 { return Theme.CurrentSunken() }
    if index == 4 { return Theme.CurrentText() }
    if index == 5 { return Theme.CurrentMuted() }
    if index == 6 { return Theme.CurrentDisabled() }
    if index == 7 { return Theme.CurrentBorder() }
    if index == 8 { return Theme.CurrentBorderStrong() }
    if index == 9 { return Theme.CurrentAccent() }
    if index == 10 { return Theme.CurrentAccentPressed() }
    if index == 11 { return Theme.CurrentSelection() }
    if index == 12 { return Theme.CurrentSelectionText() }
    if index == 13 { return Theme.CurrentSuccess() }
    if index == 14 { return Theme.CurrentWarning() }
    return Theme.CurrentDanger()
}

CssThemeToken :: (name: CssName) -> CssToken {
    token: CssToken
    token.kind = cast(s32)CssTokenUndefined
    prefix := "kryon-"
    if name.length <= cast(s32)prefix.count { return token }
    for index: 0..cast(s32)prefix.count - 1 {
        if name.bytes[index] != prefix[index] { return token }
    }
    rest := TextView(name.bytes[cast(s32)prefix.count:name.length])
    for entry, index: css_theme_tokens {
        if rest == entry {
            token.kind = cast(s32)CssTokenColor
            token.color = CssThemeColor(cast(s32)index)
            return token
        }
    }
    return token
}

CssSheetBuild :: (sheet: *CssSheet, env: CssEnvironment, overrides: *CssOverrides,
    rules: *StyleRules) -> bool {
    rules.count = 0
    if !CssSheetResolve(sheet, env, overrides) { return false }
    width, height := CssEnvironmentViewport(env)
    expr: s32 = 0
    ref: s32 = 0
    for index: cast(s32)0..sheet.rule_count - 1 {
        active: bool = CssSheetConditionHolds(sheet, sheet.rules[index].condition, env)
        if active && rules.count >= StyleRuleCapacity {
            CssSheetFail(sheet, "more than 512 rules apply at once")
            return false
        }
        if active { rules.items[rules.count] = sheet.rules[index].rule }
        while ref < sheet.ref_count && sheet.refs[ref].rule == index {
            if active {
                entry: CssSheetRef = sheet.refs[ref]
                token: CssToken = CssSheetRefToken(sheet, entry)
                if token.kind == cast(s32)CssTokenUndefined {
                    if !entry.fallback {
                        CssSheetFailAt(sheet, "undefined custom property", entry.name, entry.file, entry.line)
                        return false
                    }
                } else if !CssTokenFits(token, entry.field) {
                    if !entry.fallback {
                        sheet.failed = true
                        sheet.diagnostic_length = 0
                        CssSheetAppend(sheet, "custom property '--")
                        CssSheetAppend(sheet, TextView(sheet.names[entry.name].bytes[:sheet.names[entry.name].length]))
                        CssSheetAppend(sheet, "' is ")
                        CssSheetAppend(sheet, CssKindName(token.kind))
                        CssSheetAppend(sheet, " where the property takes another kind")
                        if entry.file >= 0 && entry.file < sheet.file_count {
                            CssSheetAppend(sheet, " at ")
                            CssSheetAppend(sheet, TextView(sheet.files[entry.file].name[:sheet.files[entry.file].length]))
                            CssSheetAppend(sheet, ":")
                            CssSheetAppendInt(sheet, entry.line)
                        }
                        return false
                    }
                } else {
                    CssStyleSetToken(*rules.items[rules.count].style, *rules.items[rules.count].box,
                        entry.field, token)
                }
                // The template already holds the fallback when the token is absent
                // or has the wrong kind. Validate whichever value will be used.
                style: *StyleData = *rules.items[rules.count].style
                invalid: bool = (entry.field == cast(s32)CssFieldMinHeight && style.min_height < 0.0) ||
                    (entry.field == cast(s32)CssFieldLineHeight && style.line_height < 0.0) ||
                    (entry.field == cast(s32)CssFieldGap && style.gap < 0.0) ||
                    (entry.field == cast(s32)CssFieldRowGap && style.row_gap < 0.0) ||
                    (entry.field == cast(s32)CssFieldColumnGap && style.column_gap < 0.0) ||
                    (entry.field == cast(s32)CssFieldFontWeight && style.font_weight == 0) ||
                    (entry.field == cast(s32)CssFieldMotionDuration && style.motion_duration < 0.0) ||
                    (entry.field == cast(s32)CssFieldMotionMultiplier && style.motion_multiplier < 0.0)
                if invalid {
                    sheet.failed = true
                    sheet.diagnostic_length = 0
                    CssSheetAppend(sheet, "custom property '--")
                    CssSheetAppend(sheet, TextView(sheet.names[entry.name].bytes[:sheet.names[entry.name].length]))
                    CssSheetAppend(sheet, "' has an invalid value at ")
                    if entry.file >= 0 && entry.file < sheet.file_count {
                        CssSheetAppend(sheet, TextView(sheet.files[entry.file].name[:sheet.files[entry.file].length]))
                        CssSheetAppend(sheet, ":")
                    }
                    CssSheetAppendInt(sheet, entry.line)
                    return false
                }
            }
            ref += 1
        }
        while expr < sheet.expr_count && sheet.exprs[expr].rule == index {
            if active {
                entry := sheet.exprs[expr]
                CssStyleSet(*rules.items[rules.count].style, *rules.items[rules.count].box, entry.field, 0,
                    cast(float32)CssExprAt(entry.expr, width, height), 0)
            }
            expr += 1
        }
        if active { rules.count += 1 }
    }
    return true
}

CssSheetPrepareInstall :: (sheet: *CssSheet, env: CssEnvironment, overrides: *CssOverrides) -> bool {
    if !CssSheetBuild(sheet, env, overrides, *css_install_rules) { return false }
    // Check the color table fits before anything changes.
    colors: s32 = 0
    for index: cast(s32)0..sheet.name_count - 1 {
        if sheet.final[index].kind != cast(s32)CssTokenColor { continue }
        colors += 1
        if sheet.final[index].name.length > 64 {
            CssSheetFailAt(sheet, "custom property name is longer than 64 bytes:", index, -1, 0)
            return false
        }
    }
    if colors > 128 {
        CssSheetFail(sheet, "more than 128 color custom properties")
        return false
    }
    return true
}

CssSheetMotionInstall :: #type () -> bool;
css_sheet_clear_motion: CssSheetMotionInstall;
css_sheet_has_motion: bool;

CssSheetInstallRules :: (sheet: *CssSheet) -> bool {
    if !InstallStyleRules(css_install_rules) {
        CssSheetFail(sheet, "Kryon rejected the style table (typeface storage)")
        return false
    }
    return true
}

CssSheetRejectMotion :: (sheet: *CssSheet, previous: StyleRules) -> bool {
    if !InstallStyleRules(previous) {
        CssSheetFail(sheet, "Kryon rejected CSS motion and could not restore the previous styles")
    } else {
        CssSheetFail(sheet, "Kryon rejected the CSS motion table")
    }
    return false
}

CssSheetInstallColors :: (sheet: *CssSheet) -> bool {
    ClearStyleTokenColors()
    for index: cast(s32)0..sheet.name_count - 1 {
        token: CssToken = sheet.final[index]
        if token.kind != cast(s32)CssTokenColor { continue }
        if !SetStyleTokenColorBytes(token.name.bytes[:token.name.length], token.color) {
            CssSheetFail(sheet, "Kryon's color token table is full")
            return false
        }
    }
    return true
}

// Install resolved widget styles and color custom properties.
#program_export
CssSheetInstall :: (sheet: *CssSheet, env: CssEnvironment, overrides: *CssOverrides) -> bool {
    if !CssSheetPrepareInstall(sheet, env, overrides) { return false }
    previous: StyleRules
    if css_sheet_has_motion { previous = ActiveStyleRules() }
    if !CssSheetInstallRules(sheet) { return false }
    if css_sheet_has_motion && !css_sheet_clear_motion() { return CssSheetRejectMotion(sheet, previous) }
    return CssSheetInstallColors(sheet)
}

CssTokenResult :: struct {
    found: bool
    kind: s32
    color: u32
    number: float32
    material: s32
}

// A custom property's value from the last resolve or install.
#program_export
CssSheetToken :: (sheet: *CssSheet, name: string) -> CssTokenResult {
    result: CssTokenResult
    bare: CssName = CssMakeName(CssBareText(name))
    for index: cast(s32)0..sheet.name_count - 1 {
        if CssNameSame(sheet.names[index], bare) {
            token: CssToken = sheet.final[index]
            if token.kind == cast(s32)CssTokenUndefined { return result }
            result.found = true
            result.kind = token.kind
            result.color = token.color
            result.number = token.number
            result.material = token.material
            return result
        }
    }
    return result
}

// Compiled sheets ---------------------------------------------------------
// The pack compiler writes these arrays; loading them skips parsing.

// One rule: selector, paint and text fields, sizes and grid tracks, flex
// and box data, the percent masks of the style, flex and box fields, then
// the per-side border widths and colors, the outline width and offset, and
// the selector's tree context. The count is the pack format: a pack written
// with another one is stale and css_tool regenerates it.
CssRuleWords :: 87
CssCompiledRefWords :: 4
// A viewport length: rule, field, which bounds it has, then the value, low
// and high linear forms as px, vw and vh.
CssCompiledExprWords :: 12
CssCompiledDefinitionWords :: 8
CssConditionWords :: 22

CssCompiledSheet :: struct {
    rules: []u32
    refs: []u32
    exprs: []u32
    definitions: []u32
    conditions: []u32
    names: []string
    themes: []string
    layers: []string
    typefaces: []string
    file: string
    rule_words: s32
    motion: []u32
    keyframes: []u32
    frames: []u32
}

CssWordLinear :: (w: []u32) -> CssLinear {
    return .{.px = cast(float64)CssWordFloat(w[0]), .vw = cast(float64)CssWordFloat(w[1]),
        .vh = cast(float64)CssWordFloat(w[2])}
}

CssWordFloat :: (word: u32) -> float32 {
    return cast(float32)Binary.Float32FromBits(word)
}

// Append a compiled sheet; its layers, names and themes merge by name.
#program_export
CssSheetLoad :: (sheet: *CssSheet, compiled: CssCompiledSheet) -> bool {
    if sheet.failed { return false }
    if compiled.rule_words != CssRuleWords || compiled.rules.count % cast(s64)CssRuleWords != 0 ||
        compiled.conditions.count % cast(s64)CssConditionWords != 0 {
        CssSheetFail(sheet, "the compiled CSS pack is stale; regenerate it with css_tool")
        return false
    }
    rule_count: s32 = cast(s32)compiled.rules.count / CssRuleWords
    ref_count: s32 = cast(s32)compiled.refs.count / CssCompiledRefWords
    definition_count: s32 = cast(s32)compiled.definitions.count / CssCompiledDefinitionWords
    condition_count: s32 = cast(s32)compiled.conditions.count / CssConditionWords
    if sheet.rule_count + rule_count > CssSheetRuleCapacity ||
        sheet.ref_count + ref_count > CssSheetRefCapacity ||
        sheet.definition_count + definition_count > CssSheetDefinitionCapacity ||
        sheet.condition_count + condition_count > CssSheetConditionCapacity {
        CssSheetFail(sheet, "the compiled sheet does not fit")
        return false
    }
    file_name: CssSourceFile = CssCopyFileName(compiled.file)
    file: s32 = CssSheetFile(sheet, file_name)
    names: [CssNameCapacity]s32
    for index: cast(s32)0..cast(s32)compiled.names.count - 1 {
        names[index] = CssSheetName(sheet, CssMakeName(compiled.names[index]))
    }
    themes: [CssThemeCapacity]s32
    for index: cast(s32)0..cast(s32)compiled.themes.count - 1 {
        themes[index] = CssSheetTheme(sheet, CssMakeName(compiled.themes[index]))
    }
    layers: [12]s32
    for index: cast(s32)0..cast(s32)compiled.layers.count - 1 {
        layers[index] = CssSheetLayer(sheet, CssMakeName(compiled.layers[index]))
    }
    if sheet.failed { return false }
    conditions: [CssSheetConditionCapacity]s32
    for index: cast(s32)0..condition_count - 1 {
        at: s32 = index * CssConditionWords
        condition: CssCondition
        condition.count = cast(s32)compiled.conditions[at]
        condition.never = compiled.conditions[at + 1] != cast(u32)0
        for branch: cast(s32)0..3 {
            mask: u32 = compiled.conditions[at + 2 + branch * 2]
            // A pack with no motion bits accepts both settings.
            if branch < condition.count && (mask & CssMotionBits) == 0 { mask |= CssMotionBits }
            condition.branches[branch].mask = mask
            theme: s32 = cast(s32)compiled.conditions[at + 3 + branch * 2] - 1
            condition.branches[branch].theme = ifx theme >= 0 then themes[theme] else -1
        }
        for branch: cast(s32)0..3 {
            pos := at + 10 + branch * 3
            condition.branches[branch].width_count = cast(s32)compiled.conditions[pos]
            condition.branches[branch].viewport_count = condition.branches[branch].width_count
            condition.branches[branch].min_width = CssWordFloat(compiled.conditions[pos + 1])
            condition.branches[branch].max_width = CssWordFloat(compiled.conditions[pos + 2])
        }
        conditions[index] = sheet.condition_count
        sheet.conditions[sheet.condition_count] = condition
        sheet.condition_count += 1
    }
    rule_base: s32 = sheet.rule_count
    for index: cast(s32)0..rule_count - 1 {
        w: []u32 = compiled.rules[index * CssRuleWords:(index + 1) * CssRuleWords]
        entry: CssSheetRule
        entry.rule.selector.kind = cast(s32)w[0]
        entry.rule.selector.name = cast(s32)w[1]
        entry.rule.selector.class_name = cast(s32)w[2]
        entry.rule.selector.id = cast(s32)w[3]
        entry.rule.selector.role = cast(s32)w[4]
        entry.rule.selector.tone = cast(s32)w[5]
        entry.rule.selector.emphasis = cast(s32)w[6]
        entry.rule.selector.size = cast(s32)w[7]
        entry.rule.selector.state = cast(s32)w[8]
        entry.rule.selector.validation = cast(s32)w[9]
        entry.rule.selector.orientation = cast(s32)w[10]
        entry.rule.selector.placement = cast(s32)w[11]
        entry.rule.state = cast(s32)w[12]
        layer: s32 = cast(s32)w[13]
        entry.rule.layer = ifx layer == CssLayerUnlayered then layer else layers[layer]
        entry.rule.order = sheet.rule_count
        condition: s32 = cast(s32)w[14] - 1
        entry.condition = ifx condition >= 0 then conditions[condition] else -1
        style: *StyleData = *entry.rule.style
        style.fields = w[15]
        style.background = w[16]
        style.foreground = w[17]
        style.border = w[18]
        style.focus = w[19]
        style.background_end = w[20]
        style.radius = CssWordFloat(w[21])
        style.border_width = CssWordFloat(w[22])
        style.opacity = CssWordFloat(w[23])
        style.padding_x = CssWordFloat(w[24])
        style.padding_y = CssWordFloat(w[25])
        style.gap = CssWordFloat(w[26])
        style.font_size = CssWordFloat(w[27])
        style.icon_size = CssWordFloat(w[28])
        style.offset_x = CssWordFloat(w[29])
        style.offset_y = CssWordFloat(w[30])
        style.letter_spacing = CssWordFloat(w[31])
        style.material = cast(MaterialKind)cast(s32)w[32]
        typeface: s32 = cast(s32)w[33] - 1
        if typeface >= 0 { style.typeface = compiled.typefaces[typeface] }
        style.min_height = CssWordFloat(w[34])
        style.line_height = CssWordFloat(w[35])
        style.font_role = cast(FontRole)cast(s32)w[36]
        style.elevation = cast(ElevationRole)cast(s32)w[37]
        style.motion_duration = CssWordFloat(w[38])
        style.motion_multiplier = CssWordFloat(w[39])
        style.motion_easing = cast(MotionEasing)cast(s32)w[40]
        style.motion_reduced = w[41] != cast(u32)0
        style.row_gap = CssWordFloat(w[42])
        style.column_gap = CssWordFloat(w[43])
        style.font_weight = cast(s32)w[44]
        style.font_style = cast(FontStyle)cast(s32)w[45]
        style.line_height_unit = cast(LineHeightUnit)cast(s32)w[46]
        style.width = CssWordFloat(w[47])
        style.height = CssWordFloat(w[48])
        style.grid_tracks = cast(s32)w[49]
        entry.rule.flex = .{.fields = w[50], .direction = cast(s32)w[51], .wrap = w[52] != 0,
            .justify_content = cast(s32)w[53], .align_items = cast(s32)w[54],
            .basis = CssWordFloat(w[55]), .grow = CssWordFloat(w[56]), .shrink = CssWordFloat(w[57]),
            .align_self = cast(s32)w[58]}
        entry.rule.box = .{.fields = w[59], .min_width = CssWordFloat(w[60]),
            .max_width = CssWordFloat(w[61]), .max_height = CssWordFloat(w[62]),
            .clip_children = w[63] != 0, .text_align = cast(s32)w[64],
            .margin_top = CssWordFloat(w[65]), .margin_right = CssWordFloat(w[66]),
            .margin_bottom = CssWordFloat(w[67]), .margin_left = CssWordFloat(w[68])}
        style.percent = w[69]
        entry.rule.flex.percent = w[70]
        entry.rule.box.percent = w[71]
        for side: 0..3 {
            entry.rule.box.border_widths[side] = CssWordFloat(w[72 + side])
            entry.rule.box.border_colors[side] = w[76 + side]
        }
        entry.rule.box.outline_width = CssWordFloat(w[80])
        entry.rule.box.outline_offset = CssWordFloat(w[81])
        entry.rule.selector.context = w[82]
        entry.rule.selector.ancestor_class = cast(s32)w[83]
        entry.rule.selector.ancestor_id = cast(s32)w[84]
        entry.rule.selector.not_class = cast(s32)w[85]
        entry.rule.selector.not_state = cast(s32)w[86]
        sheet.rules[sheet.rule_count] = entry
        sheet.rule_count += 1
    }
    for index: cast(s32)0..ref_count - 1 {
        at: s32 = index * CssCompiledRefWords
        ref: CssSheetRef
        ref.rule = rule_base + cast(s32)compiled.refs[at]
        ref.name = names[cast(s32)compiled.refs[at + 1]]
        ref.field = cast(s32)(compiled.refs[at + 2] & cast(u32)255)
        ref.fallback = (compiled.refs[at + 2] & cast(u32)256) != cast(u32)0
        alternate := cast(s32)(compiled.refs[at + 2] >> cast(u32)16)
        if alternate > 0 { ref.alternate = names[alternate - 1] + 1 }
        ref.file = file
        ref.line = cast(s32)compiled.refs[at + 3]
        sheet.refs[sheet.ref_count] = ref
        sheet.ref_count += 1
    }
    expr_count: s32 = cast(s32)compiled.exprs.count / CssCompiledExprWords
    if sheet.expr_count + expr_count > CssSheetExprCapacity {
        CssSheetFail(sheet, "the compiled sheet does not fit")
        return false
    }
    for index: cast(s32)0..expr_count - 1 {
        w: []u32 = compiled.exprs[index * CssCompiledExprWords:(index + 1) * CssCompiledExprWords]
        entry: CssSheetExpr = .{.rule = rule_base + cast(s32)w[0], .field = cast(s32)w[1]}
        entry.expr.has_low = (w[2] & cast(u32)1) != 0
        entry.expr.has_high = (w[2] & cast(u32)2) != 0
        entry.expr.value = CssWordLinear(w[3:6])
        entry.expr.low = CssWordLinear(w[6:9])
        entry.expr.high = CssWordLinear(w[9:12])
        entry.expr.ok = true
        sheet.exprs[sheet.expr_count] = entry
        sheet.expr_count += 1
    }
    for index: cast(s32)0..definition_count - 1 {
        at: s32 = index * CssCompiledDefinitionWords
        definition: CssSheetDefinition
        definition.name = names[cast(s32)compiled.definitions[at]]
        condition: s32 = cast(s32)compiled.definitions[at + 1] - 1
        definition.condition = ifx condition >= 0 then conditions[condition] else -1
        definition.kind = cast(s32)compiled.definitions[at + 2]
        definition.color = compiled.definitions[at + 3]
        definition.number = CssWordFloat(compiled.definitions[at + 4])
        definition.material = cast(s32)compiled.definitions[at + 5]
        alias: s32 = cast(s32)compiled.definitions[at + 6] - 1
        definition.alias = ifx alias >= 0 then names[alias] else -1
        definition.file = file
        definition.line = cast(s32)compiled.definitions[at + 7]
        sheet.definitions[sheet.definition_count] = definition
        sheet.definition_count += 1
    }
    return CssSheetLoadMotion(sheet, compiled, rule_base, rule_count, conditions[:condition_count],
        layers[:compiled.layers.count])
}

#load "sheet_motion_pack.zi";
