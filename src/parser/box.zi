// Native box declarations: min/max sizes, margins and overflow of Row,
// Column and Grid containers, and text-align of Text. They are stored apart
// from paint fields; Layout reads them when it places a container in its
// parent's slot, and Text when it lines up its lines.

css_box_properties: [17]string = .["min-width", "max-width", "max-height",
    "min-inline-size", "max-inline-size", "max-block-size", "margin", "margin-top",
    "margin-right", "margin-bottom", "margin-left", "margin-inline", "margin-block",
    "margin-inline-start", "margin-inline-end", "overflow", "text-align"];

CssBoxProperty :: (name: CssName) -> bool {
    for property: css_box_properties {
        if CssNameEquals(name, property) { return true }
    }
    return false
}

CssBoxTarget :: (p: *CssParser, name: CssName, text: bool) {
    if !CssCollectIssues(p) { return }
    for index: cast(s32)0..p.selector_count - 1 {
        kind := p.selectors[index].selector.kind
        if kind == StyleKindAny() { continue }
        if text && (kind == StyleKindText() || kind == StyleKindHeading() ||
            kind == StyleKindParagraphText() || kind == StyleKindLink()) { continue }
        if !text && (kind == StyleKindRow() || kind == StyleKindColumn() || kind == StyleKindGrid()) { continue }
        reason := "box properties apply to native Row, Column and Grid"
        if text { reason = "text-align applies to native Text" }
        CssReportIssue(p, p.pending_name_cursor, CssIssueKind.Declaration, TextView(name.bytes[:name.length]),
            reason, true)
        return
    }
}

// One length in logical pixels: px, rem, em, zero or a calc(), min(), max()
// or clamp() of them. `keyword` is accepted as the given sentinel (`none`
// for maxima, `auto` for margins).
CssBoxLength :: (p: *CssParser, keyword: string, sentinel: float32) -> (value: float32, ok: bool) {
    CssSkipSpace(p)
    origin := p.cursor
    word := CssReadName(p)
    if keyword != "" && CssNameEquals(word, keyword) { return sentinel, true }
    p.cursor = origin
    length, ok := CssReadStaticLength(p)
    if !ok || length < 0.0 { return 0.0, false }
    return length, true
}

// Up to `most` margins (lengths or auto) in CSS shorthand order.
CssBoxMargins :: (p: *CssParser, end: s32, most: s32) -> (values: [4]float32, count: s32) {
    margins: [4]float32
    found: s32 = 0
    while CssMoreValue(p, end) {
        if found >= most { return margins, -1 }
        margin, ok := CssBoxLength(p, "auto", -1.0)
        if !ok { return margins, -1 }
        margins[found] = margin
        found += 1
    }
    return margins, found
}

CssSetMargin :: (box: *StyleBoxData, field: StyleBoxField, value: float32) {
    if field == .StyleBoxMarginTop { box.margin_top = value }
    else if field == .StyleBoxMarginRight { box.margin_right = value }
    else if field == .StyleBoxMarginBottom { box.margin_bottom = value }
    else { box.margin_left = value }
    box.fields |= cast(u32)field
}

CssApplyBoxProperty :: (p: *CssParser, name: CssName, end: s32) -> s32 {
    status := p.status
    box := p.box_template
    valid := true
    text := false
    if CssNameEquals(name, "min-width") || CssNameEquals(name, "min-inline-size") {
        value, ok := CssBoxLength(p, "", 0.0)
        box.min_width = value
        box.fields |= cast(u32)StyleBoxMinWidth
        valid = ok
    } else if CssNameEquals(name, "max-width") || CssNameEquals(name, "max-inline-size") {
        value, ok := CssBoxLength(p, "none", -1.0)
        box.max_width = value
        box.fields |= cast(u32)StyleBoxMaxWidth
        valid = ok
    } else if CssNameEquals(name, "max-height") || CssNameEquals(name, "max-block-size") {
        value, ok := CssBoxLength(p, "none", -1.0)
        box.max_height = value
        box.fields |= cast(u32)StyleBoxMaxHeight
        valid = ok
    } else if CssNameEquals(name, "overflow") {
        word := CssReadName(p)
        box.clip_children = CssNameEquals(word, "hidden") || CssNameEquals(word, "clip")
        box.fields |= cast(u32)StyleBoxClipChildren
        valid = box.clip_children || CssNameEquals(word, "visible")
    } else if CssNameEquals(name, "text-align") {
        word := CssReadName(p)
        text = true
        box.text_align = -1
        if CssNameEquals(word, "start") || CssNameEquals(word, "left") { box.text_align = 0 }
        if CssNameEquals(word, "center") { box.text_align = 1 }
        if CssNameEquals(word, "end") || CssNameEquals(word, "right") { box.text_align = 2 }
        box.fields |= cast(u32)StyleBoxTextAlign
        valid = box.text_align >= 0
    } else {
        // margin, margin-<side>, margin-inline and margin-block.
        most: s32 = 4
        if CssNameEquals(name, "margin-inline") || CssNameEquals(name, "margin-block") { most = 2 }
        else if !CssNameEquals(name, "margin") { most = 1 }
        values, count := CssBoxMargins(p, end, most)
        valid = count > 0
        if valid {
            top := values[0]
            right := ifx count >= 2 then values[1] else top
            bottom := ifx count >= 3 then values[2] else top
            left := ifx count == 4 then values[3] else right
            if CssNameEquals(name, "margin") {
                CssSetMargin(*box, .StyleBoxMarginTop, top)
                CssSetMargin(*box, .StyleBoxMarginRight, right)
                CssSetMargin(*box, .StyleBoxMarginBottom, bottom)
                CssSetMargin(*box, .StyleBoxMarginLeft, left)
            } else if CssNameEquals(name, "margin-inline") {
                CssSetMargin(*box, .StyleBoxMarginLeft, top)
                CssSetMargin(*box, .StyleBoxMarginRight, right)
            } else if CssNameEquals(name, "margin-block") {
                CssSetMargin(*box, .StyleBoxMarginTop, top)
                CssSetMargin(*box, .StyleBoxMarginBottom, right)
            } else if CssNameEquals(name, "margin-top") {
                CssSetMargin(*box, .StyleBoxMarginTop, top)
            } else if CssNameEquals(name, "margin-bottom") {
                CssSetMargin(*box, .StyleBoxMarginBottom, top)
            } else if CssNameEquals(name, "margin-left") || CssNameEquals(name, "margin-inline-start") {
                CssSetMargin(*box, .StyleBoxMarginLeft, top)
            } else {
                CssSetMargin(*box, .StyleBoxMarginRight, top)
            }
        }
    }
    if !valid || CssMoreValue(p, end) || CssFailed(p) {
        p.status = status
        p.diagnostic_length = 0
        return CssPassWebDeclaration(p)
    }
    CssBoxTarget(p, name, text)
    p.box_template = box
    return CssScopeNative
}
