css_catalog_9: [3]CssCatalogEntry = .[
    .{"scale", "Button", "1.05", "none, or one or two numbers or percentages"},
    .{"rotate", "Text", "-3deg", "none or an angle"},
    .{"transform-origin", "Column", "left top", "left, center, right, top, bottom, lengths or percentages"}];

CssCatalogEntryAt :: (index: s32) -> CssCatalogEntry {
    row := index % 10
    block := index / 10
    if block == 0 { return css_catalog_0[row] }
    if block == 1 { return css_catalog_1[row] }
    if block == 2 { return css_catalog_2[row] }
    if block == 3 { return css_catalog_3[row] }
    if block == 4 { return css_catalog_4[row] }
    if block == 5 { return css_catalog_5[row] }
    if block == 6 { return css_catalog_6[row] }
    if block == 7 { return css_catalog_7[row] }
    if block == 8 { return css_catalog_8[row] }
    return css_catalog_9[row]
}
