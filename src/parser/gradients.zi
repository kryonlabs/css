// linear-gradient([<angle> | to <side or corner>,] <color> [<n>%], ...) and
// radial-gradient([circle | ellipse] [<extent> | <radius> [<radius>]]?
// [at <position>]?, <color> [<n>%], ...), up to six stops each. A top to
// bottom two-stop linear gradient stays a two-color face that every widget
// paints; anything else is box fields Row, Column and Grid paint, while
// other widgets paint the first and last colors top to bottom. Conic and
// repeating gradients are browser-only.

CssGradientStopLimit :: 6

// A gradient only the browser paints, at the cursor; the cursor stays.
CssAtWebGradient :: (p: *CssParser) -> bool {
    CssSkipSpace(p)
    saved := p.cursor
    found := CssAtFunction(p, "conic-gradient") ||
        CssAtFunction(p, "repeating-linear-gradient") || CssAtFunction(p, "repeating-radial-gradient") ||
        CssAtFunction(p, "repeating-conic-gradient")
    p.cursor = saved
    return found
}

// `to` followed by one or two sides: the angle, or a corner from 1 (top
// right) clockwise to 4 (top left).
CssReadGradientSides :: (p: *CssParser) -> (angle: float64, corner: s32) {
    vertical: s32 = 0
    horizontal: s32 = 0
    for step: 0..1 {
        CssSkipSpace(p)
        if !CssNameStart(CssPeek(p, 0)) { break }
        side := CssReadName(p)
        if CssNameEquals(side, "top") { vertical = -1 }
        else if CssNameEquals(side, "bottom") { vertical = 1 }
        else if CssNameEquals(side, "left") { horizontal = -1 }
        else if CssNameEquals(side, "right") { horizontal = 1 }
        else {
            CssFail(p, "expected top, bottom, left or right after 'to'")
            return 0.0, 0
        }
    }
    if vertical == 0 && horizontal == 0 {
        CssFail(p, "expected top, bottom, left or right after 'to'")
        return 0.0, 0
    }
    if vertical == 0 { return ifx horizontal > 0 then 90.0 else 270.0, 0 }
    if horizontal == 0 { return ifx vertical > 0 then 180.0 else 0.0, 0 }
    if vertical < 0 { return 0.0, ifx horizontal > 0 then 1 else 4 }
    return 0.0, ifx horizontal > 0 then 2 else 3
}

// An angle in degrees: deg, turn, rad, grad, or a unitless zero.
CssReadGradientAngle :: (p: *CssParser) -> float64 {
    number := CssReadNumber(p)
    if CssFailed(p) { return 0.0 }
    if !number.ok || number.percent { CssFail(p, "expected a gradient angle"); return 0.0 }
    if CssNameEquals(number.unit, "deg") || (number.unit.length == 0 && number.value == 0.0) { return number.value }
    if CssNameEquals(number.unit, "turn") { return number.value * 360.0 }
    if CssNameEquals(number.unit, "rad") { return number.value * 180.0 / 3.14159265358979 }
    if CssNameEquals(number.unit, "grad") { return number.value * 0.9 }
    CssFailName(p, "angle unit", number.unit, " is outside Kryon CSS; use deg, turn, rad or grad")
    return 0.0
}

// CSS fills missing stop positions: the ends at 0 and 1, the rest evenly
// between the known ones, each at least the one before.
CssFillGradientStops :: (positions: []float64) {
    count := cast(s32)positions.count
    if positions[0] < 0.0 { positions[0] = 0.0 }
    if positions[count - 1] < 0.0 { positions[count - 1] = 1.0 }
    index: s32 = 1
    while index < count {
        if positions[index] >= 0.0 { index += 1; continue }
        next := index
        while positions[next] < 0.0 { next += 1 }
        from := positions[index - 1]
        span := cast(float64)(next - index + 1)
        for fill: index..next - 1 {
            positions[fill] = from + (positions[next] - from) * cast(float64)(fill - index + 1) / span
        }
        index = next
    }
    for fix: 1..count - 1 {
        if positions[fix] < positions[fix - 1] { positions[fix] = positions[fix - 1] }
    }
}

// The stop list both gradients share: colors with optional percentage
// positions, at most six and at least two, then ')', with the missing
// positions filled. The arrays and count come back together.
CssReadGradientStopList :: (p: *CssParser, closer: string) -> (count: s32, colors: [6]CssValue, positions: [6]float64) {
    count: s32 = 0
    colors: [6]CssValue
    positions: [6]float64
    while true {
        if count >= CssGradientStopLimit {
            CssFail(p, "Kryon gradients take up to six color stops")
            return count, colors, positions
        }
        color := CssReadColor(p, true)
        if !color.ok { return count, colors, positions }
        colors[count] = color
        positions[count] = -1.0
        CssSkipSpace(p)
        if CssFailed(p) { return count, colors, positions }
        next := CssPeek(p, 0)
        if CssIsDigit(next) || next == #char "." || next == #char "-" {
            stop := CssReadNumber(p)
            if CssFailed(p) { return count, colors, positions }
            if !stop.ok || !stop.percent {
                CssFail(p, "gradient stop positions are percentages natively")
                return count, colors, positions
            }
            positions[count] = stop.value / 100.0
            CssSkipSpace(p)
            if CssIsDigit(CssPeek(p, 0)) {
                CssFail(p, "one position per gradient stop natively")
                return count, colors, positions
            }
        }
        count += 1
        CssSkipSpace(p)
        if CssFailed(p) { return count, colors, positions }
        if !CssAtByte(p, #char ",") { break }
        CssAdvance(p, 1)
        CssSkipSpace(p)
    }
    if !CssExpect(p, #char ")", closer) { return count, colors, positions }
    if count < 2 {
        CssFail(p, "a gradient needs two colors")
        return count, colors, positions
    }
    CssFillGradientStops(positions[:count])
    return count, colors, positions
}

// The rest of linear-gradient( after its opening parenthesis.
CssReadLinearGradient :: (p: *CssParser, end: s32, property: CssName) {
    angle: float64 = 180.0
    corner: s32 = 0
    CssSkipSpace(p)
    if CssFailed(p) { return }
    byte := CssPeek(p, 0)
    if CssNameStart(byte) && !CssAtColorFunction(p) {
        saved := p.cursor
        word := CssReadName(p)
        if CssFailed(p) { return }
        if CssNameEquals(word, "to") {
            side_angle, side_corner := CssReadGradientSides(p)
            angle = side_angle
            corner = side_corner
            if CssFailed(p) || !CssExpect(p, #char ",", "expected ',' after the gradient direction") { return }
        } else {
            p.cursor = saved
        }
    } else if CssIsDigit(byte) || byte == #char "-" || byte == #char "+" || byte == #char "." {
        angle = CssReadGradientAngle(p)
        if CssFailed(p) || !CssExpect(p, #char ",", "expected ',' after the gradient angle") { return }
    }
    count, colors, positions := CssReadGradientStopList(p, "expected ')' to close linear-gradient()")
    if CssFailed(p) { return }
    turned := angle - 360.0 * cast(float64)cast(s64)(angle / 360.0)
    if turned < 0.0 { turned += 360.0 }
    simple := corner == 0 && count == 2 && positions[0] == 0.0 && positions[1] == 1.0 &&
        (turned == 180.0 || turned == 0.0)
    first := ifx simple && turned == 0.0 then 1 else 0
    CssSetValue(p, cast(s32)CssFieldBackground, colors[first])
    CssSetValue(p, cast(s32)CssFieldBackgroundEnd, colors[ifx first == 1 then 0 else count - 1])
    CssClearGradient(p)
    if !simple {
        for index: 1..count - 2 {
            CssSetValue(p, cast(s32)CssFieldGradientStop1 + index - 1, colors[index])
        }
        box := *p.box_template
        radians := turned * 3.14159265358979 / 180.0
        box.gradient_dx = cast(float32)Sin(radians)
        box.gradient_dy = cast(float32)-Cos(radians)
        box.gradient_corner = corner
        box.gradient_count = count
        for index: 0..count - 1 { box.gradient_stops[index] = cast(float32)positions[index] }
        box.fields |= cast(u32)StyleBoxGradient
        CssGradientTarget(p, property, "an angled or multi-stop gradient paints on Row, Column and Grid; other widgets paint its first and last colors top to bottom")
    }
    unused CssEndValue(p, end, property)
}

// Drop a gradient set earlier in the rule, its middle stops' var() included.
CssClearGradient :: (p: *CssParser) {
    p.box_template.fields &= ~cast(u32)StyleBoxGradient
    p.box_template.fields &= ~cast(u32)StyleBoxRadial
    p.box_template.radial_shape = 0
    p.box_template.radial_size = 0
    p.box_template.radial_cx = 0.0
    p.box_template.radial_cy = 0.0
    p.box_template.radial_rx = 0.0
    p.box_template.radial_ry = 0.0
    kept: s32 = 0
    for index: cast(s32)0..p.rule_ref_count - 1 {
        field := p.rule_refs[index].field
        if field >= cast(s32)CssFieldGradientStop1 && field <= cast(s32)CssFieldGradientStop4 { continue }
        p.rule_refs[kept] = p.rule_refs[index]
        kept += 1
    }
    p.rule_ref_count = kept
}

CssGradientTarget :: (p: *CssParser, property: CssName, message: string) {
    if !CssCollectIssues(p) { return }
    for index: cast(s32)0..p.selector_count - 1 {
        kind := p.selectors[index].selector.kind
        if kind == StyleKindAny() || kind == StyleKindRow() || kind == StyleKindColumn() || kind == StyleKindGrid() { continue }
        CssReportIssue(p, p.pending_name_cursor, CssIssueKind.Declaration, TextView(property.bytes[:property.length]),
            message, false)
        return
    }
}

// One piece of `at <position>`: a percentage or a side keyword. Percentages
// fill the horizontal then the vertical share; a vertical keyword flips the
// order, as CSS reads top before a following share. One piece alone is the
// horizontal one.
CssReadRadialPosition :: (p: *CssParser) -> (x: float64, y: float64) {
    x: float64 = -1.0
    y: float64 = -1.0
    vertical: bool = false
    for piece: 0..1 {
        CssSkipSpace(p)
        if CssFailed(p) { return x, y }
        byte := CssPeek(p, 0)
        if !CssIsDigit(byte) && byte != #char "." && !CssNameStart(byte) { break }
        if CssIsDigit(byte) || byte == #char "." {
            number := CssReadNumber(p)
            if CssFailed(p) { return x, y }
            if !number.ok || !number.percent {
                CssFail(p, "a radial center position is a percentage or side keyword natively")
                return x, y
            }
            share := number.value / 100.0
            if vertical || x >= 0.0 { y = share } else { x = share }
        } else {
            word := CssReadName(p)
            if CssFailed(p) { return x, y }
            if CssNameEquals(word, "left") { x = 0.0 }
            else if CssNameEquals(word, "right") { x = 1.0 }
            else if CssNameEquals(word, "top") { y = 0.0; vertical = true }
            else if CssNameEquals(word, "bottom") { y = 1.0; vertical = true }
            else if CssNameEquals(word, "center") {
                if x >= 0.0 { y = 0.5 } else { x = 0.5 }
            } else {
                CssFailName(p, "position word", word, " is outside Kryon CSS; use left, right, top, bottom or center")
                return x, y
            }
        }
    }
    if x < 0.0 { x = 0.5 }
    if y < 0.0 { y = 0.5 }
    return x, y
}

// One explicit radius: a percentage of the box's width or height, stored as
// a negative fraction, or a static length. A radius never starts with a
// name; the caller checks the bytes first.
CssReadRadialRadius :: (p: *CssParser) -> (value: float64, ok: bool) {
    CssSkipSpace(p)
    percentage, is_percent := CssReadPercent(p)
    if is_percent {
        if percentage < 0.0 {
            CssFail(p, "a radial gradient's radius is zero or more")
            return 0.0, false
        }
        return -cast(float64)percentage / 100.0, true
    }
    byte := CssPeek(p, 0)
    if !CssIsDigit(byte) && byte != #char "." && byte != #char "-" && byte != #char "+" { return 0.0, false }
    length, is_length := CssReadStaticLength(p)
    if !is_length || length < 0.0 { return 0.0, false }
    return cast(float64)length, true
}

// The rest of radial-gradient( after its opening parenthesis: an optional
// shape and extent keyword in either order, explicit radii instead of an
// extent, an optional `at` position, then the shared stop list. A single
// radius makes a circle; explicit radii are px lengths or percentages of
// the box, unlike an extent keyword, which measures the box.
CssReadRadialGradient :: (p: *CssParser, end: s32, property: CssName) {
    shape: s32 = 0
    size: s32 = 0
    rx: float64 = 0.0
    ry: float64 = 0.0
    center_x: float64 = 0.5
    center_y: float64 = 0.5
    named_shape: bool = false
    named_size: bool = false
    leading: bool = false
    CssSkipSpace(p)
    if CssFailed(p) { return }
    // The shape and the extent keyword come in either order.
    for round: 0..1 {
        CssSkipSpace(p)
        if !CssNameStart(CssPeek(p, 0)) { break }
        saved := p.cursor
        word := CssReadName(p)
        if CssFailed(p) { return }
        if CssNameEquals(word, "circle") { shape = 1; named_shape = true }
        else if CssNameEquals(word, "ellipse") { shape = 0; named_shape = true }
        else if CssNameEquals(word, "closest-corner") { size = 1; named_size = true }
        else if CssNameEquals(word, "closest-side") { size = 2; named_size = true }
        else if CssNameEquals(word, "farthest-corner") { size = 0; named_size = true }
        else if CssNameEquals(word, "farthest-side") { size = 3; named_size = true }
        else { p.cursor = saved; break }
    }
    if named_shape || named_size { leading = true }
    // Explicit radii: one for a circle, two for an ellipse.
    byte := CssPeek(p, 0)
    if CssIsDigit(byte) || byte == #char "." || byte == #char "-" || byte == #char "+" {
        first, ok := CssReadRadialRadius(p)
        if CssFailed(p) { return }
        if !ok {
            CssFail(p, "a radial gradient's radius is a percentage or px length natively")
            return
        }
        if named_size {
            CssFail(p, "a radial size is one extent keyword or explicit radii, not both")
            return
        }
        leading = true
        rx = first
        saved := p.cursor
        second, more := CssReadRadialRadius(p)
        if CssFailed(p) { return }
        if more {
            if shape == 1 {
                CssFail(p, "a circle takes one radius; an ellipse takes two")
                return
            }
            ry = second
        } else {
            p.cursor = saved
            if first < 0.0 {
                CssFail(p, "one radius makes a circle; a circle's radius is a px length, percentages need an ellipse")
                return
            }
            if named_shape && shape == 0 {
                CssFail(p, "an ellipse takes two radii; a single radius makes a circle")
                return
            }
            shape = 1
            ry = rx
        }
    }
    // `at <position>` when the next word says so.
    CssSkipSpace(p)
    if CssNameStart(CssPeek(p, 0)) {
        saved := p.cursor
        word := CssReadName(p)
        if CssFailed(p) { return }
        if CssNameEquals(word, "at") {
            px, py := CssReadRadialPosition(p)
            if CssFailed(p) { return }
            center_x = px
            center_y = py
            leading = true
        } else {
            p.cursor = saved
        }
    }
    if leading {
        if !CssExpect(p, #char ",", "expected ',' after the radial gradient's shape, size or position") { return }
    }
    count, colors, positions := CssReadGradientStopList(p, "expected ')' to close radial-gradient()")
    if CssFailed(p) { return }
    CssSetValue(p, cast(s32)CssFieldBackground, colors[0])
    CssSetValue(p, cast(s32)CssFieldBackgroundEnd, colors[count - 1])
    CssClearGradient(p)
    for index: 1..count - 2 {
        CssSetValue(p, cast(s32)CssFieldGradientStop1 + index - 1, colors[index])
    }
    box := *p.box_template
    box.radial_shape = shape
    box.radial_size = size
    box.radial_rx = cast(float32)rx
    box.radial_ry = cast(float32)ry
    box.radial_cx = cast(float32)center_x
    box.radial_cy = cast(float32)center_y
    box.gradient_count = count
    for index: 0..count - 1 { box.gradient_stops[index] = cast(float32)positions[index] }
    box.fields |= cast(u32)StyleBoxRadial
    CssGradientTarget(p, property, "a radial gradient paints on Row, Column and Grid; other widgets paint its first and last colors top to bottom")
    unused CssEndValue(p, end, property)
}
