// Part of the css_parser module: selectors. Kryon CSS selectors are flat
// compounds, matched by table lookup: an optional widget type or '*', then
// any '.class', '[attribute=value]' and one state pseudo-class, e.g.
// 'Button.hero[tone=accent]:hover'. A comma list gives one rule each.

#program_export
CssClass :: (name: string) -> s32 {
    return CssClassId(CssMakeName(name))
}

// The Kryon state a pseudo-class selects, or -1.
CssPseudoState :: (name: CssName) -> s32 {
    if CssNameEquals(name, "hover") { return cast(s32)ButtonStateHover }
    if CssNameEquals(name, "active") { return cast(s32)ButtonStatePressed }
    if CssNameEquals(name, "focus") || CssNameEquals(name, "focus-visible") {
        return cast(s32)ButtonStateFocus
    }
    if CssNameEquals(name, "disabled") { return cast(s32)ButtonStateDisabled }
    // Kryon pseudo-classes: a chosen tab, segment, row or checked control.
    if CssNameEquals(name, "selected") || CssNameEquals(name, "checked") {
        return cast(s32)ButtonStateSelected
    }
    if CssNameEquals(name, "loading") { return cast(s32)ButtonStateLoading }
    return -1
}

CssSelectorValue :: (p: *CssParser) -> CssName {
    name: CssName
    CssSkipSpace(p)
    if CssFailed(p) { return name }
    if CssAtByte(p, #char "\"") || CssAtByte(p, #char "'") {
        span: CssStringSpan = CssReadString(p)
        if !span.ok { return name }
        if span.length > 64 {
            CssFail(p, "attribute value longer than 64 bytes")
            return name
        }
        return CssMakeName(p.cursor.source[span.start:span.start + span.length])
    }
    name = CssReadName(p)
    if !CssFailed(p) && name.length == 0 { CssFail(p, "expected an attribute value") }
    return name
}

// '[attribute=value]' after the '['.
CssReadAttribute :: (p: *CssParser, selector: *StyleSelector) {
    CssSkipSpace(p)
    if CssFailed(p) { return }
    attribute: CssName = CssReadName(p)
    if CssFailed(p) { return }
    if attribute.length == 0 {
        CssFail(p, "expected an attribute name")
        return
    }
    CssSkipSpace(p)
    if !CssAtByte(p, #char "=") {
        if CssAtByte(p, #char "]") { CssFailName(p, "attribute", attribute, " needs '=value'") }
        else { CssFail(p, "only '=' attribute matches are part of Kryon CSS") }
        return
    }
    CssAdvance(p, 1)
    value: CssName = CssSelectorValue(p)
    if CssFailed(p) { return }
    if !CssExpect(p, #char "]", "expected ']'") { return }
    mapped: s32 = -999999
    if CssNameEquals(attribute, "tone") {
        mapped = CssToneValue(value)
        if mapped != -999999 { selector.tone = mapped }
    } else if CssNameEquals(attribute, "emphasis") {
        mapped = CssEmphasisValue(value)
        if mapped != -999999 { selector.emphasis = mapped }
    } else if CssNameEquals(attribute, "size") {
        mapped = CssSizeValue(value)
        if mapped != -999999 { selector.size = mapped }
    } else if CssNameEquals(attribute, "role") {
        mapped = CssRoleValue(value)
        if mapped != -999999 { selector.role = mapped }
    } else if CssNameEquals(attribute, "state") {
        mapped = CssStateValue(value)
        if mapped != -999999 { selector.state = mapped }
    } else {
        CssFailName(p, "unknown attribute", attribute,
            "; Kryon CSS matches tone, emphasis, size, role and state")
        return
    }
    if mapped == -999999 { CssFailName(p, "unknown value", value, "") }
}

// One compound selector at the cursor. Returns false after a diagnostic.
CssReadCompound :: (p: *CssParser, pending: *CssPendingSelector) -> bool {
    CssSkipSpace(p)
    if CssFailed(p) { return false }
    pending.selector = StyleDefaultSelector()
    pending.state = StyleStateAny()
    pending.start = p.cursor.pos
    parts: s32 = 0
    if CssAtByte(p, #char "*") {
        CssAdvance(p, 1)
        parts += 1
    } else if CssNameStart(CssPeek(p, 0)) {
        name: CssName = CssReadName(p)
        if CssFailed(p) { return false }
        kind: s32 = CssKindValue(name)
        if kind == -999999 {
            CssFailName(p, "unknown widget type", name, "")
            return false
        }
        pending.selector.kind = kind
        parts += 1
    }
    while !CssAtEnd(p) {
        byte: u8 = p.cursor.source[p.cursor.pos]
        if byte == #char "." {
            CssAdvance(p, 1)
            name: CssName = CssReadName(p)
            if CssFailed(p) { return false }
            if name.length == 0 {
                CssFail(p, "expected a class name after '.'")
                return false
            }
            if pending.selector.class_name != 0 {
                CssFail(p, "one class per selector in Kryon CSS")
                return false
            }
            pending.selector.class_name = CssClassId(name)
        } else if byte == #char "[" {
            CssAdvance(p, 1)
            CssReadAttribute(p, *pending.selector)
            if CssFailed(p) { return false }
        } else if byte == #char ":" {
            if CssPeek(p, 1) == #char ":" {
                CssFail(p, "pseudo-elements are outside Kryon CSS")
                return false
            }
            CssAdvance(p, 1)
            name: CssName = CssReadName(p)
            if CssFailed(p) { return false }
            if CssAtByte(p, #char "(") {
                CssFailName(p, "selector function", name, "() is outside Kryon CSS")
                return false
            }
            state: s32 = CssPseudoState(name)
            if state < 0 {
                if CssNameEquals(name, "root") { CssFail(p, ":root holds only custom properties") }
                else { CssFailName(p, "unknown pseudo-class", name, "") }
                return false
            }
            if pending.state != StyleStateAny() {
                CssFail(p, "one state pseudo-class per selector")
                return false
            }
            pending.state = state
        } else if byte == #char "#" {
            CssFail(p, "id selectors are outside Kryon CSS; use a class")
            return false
        } else {
            break
        }
        parts += 1
    }
    if parts == 0 {
        CssFail(p, "expected a selector")
        return false
    }
    pending.length = p.cursor.pos - pending.start
    CssSkipSpace(p)
    if CssFailed(p) { return false }
    if CssAtByte(p, #char ",") || CssAtByte(p, #char "{") { return true }
    if CssAtByte(p, #char ">") || CssAtByte(p, #char "+") || CssAtByte(p, #char "~") ||
        CssNameStart(CssPeek(p, 0)) || CssAtByte(p, #char "*") || CssAtByte(p, #char ".") {
        CssFail(p, "combinators are outside Kryon CSS; style the widget with a class")
        return false
    }
    CssFail(p, "expected '{' after the selector")
    return false
}

// A selector list up to '{'. ':root' alone opens a custom property block.
CssReadSelectorList :: (p: *CssParser) -> bool {
    p.selector_count = 0
    p.selector_next = 0
    p.selector_start = p.cursor.pos
    while true {
        if p.selector_count >= 8 {
            CssFail(p, "more than 8 selectors in one list")
            return false
        }
        if !CssReadCompound(p, *p.selectors[p.selector_count]) { return false }
        p.selector_count += 1
        if CssAtByte(p, #char "{") { break }
        CssAdvance(p, 1)
    }
    p.selector_length = p.cursor.pos - p.selector_start
    while p.selector_length > 0 && CssIsSpace(p.cursor.source[p.selector_start + p.selector_length - 1]) {
        p.selector_length -= 1
    }
    return true
}

// Is the cursor at ':root' followed by '{'? Consumes ':root' when it is.
CssAtRoot :: (p: *CssParser) -> bool {
    if CssPeek(p, 0) != #char ":" { return false }
    probe: string = ":root"
    for index: cast(s32)0..4 {
        if CssLower(CssPeek(p, index)) != probe[index] { return false }
    }
    if CssNameChar(CssPeek(p, 5)) { return false }
    saved: CssCursor = p.cursor
    CssAdvance(p, 5)
    CssSkipSpace(p)
    if CssFailed(p) { return false }
    if CssAtByte(p, #char "{") { return true }
    if CssAtByte(p, #char ",") {
        CssFail(p, ":root holds only custom properties; give it its own block")
        return false
    }
    p.cursor = saved
    return false
}
