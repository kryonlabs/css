// Part of the css_parser module: statements and the step that drives a parse.
// CssStep returns one item at a time: a style rule, a custom property, an
// @keyframes block, an @import request, the end, or an error.

CssCurrentCondition :: (p: *CssParser) -> CssCondition {
    if p.depth == 0 { return CssCondition.{} }
    return p.blocks[p.depth - 1].condition
}

CssOpenBlock :: (p: *CssParser, kind: s32, condition: CssCondition, query_start: s32,
    query_length: s32) -> bool {
    if p.depth >= 6 {
        CssFail(p, "blocks nested more than 6 deep")
        return false
    }
    block: CssBlock
    block.kind = kind
    block.outer_layer = p.layer
    block.condition = condition
    block.query_start = query_start
    block.query_length = query_length
    block.file = p.cursor.file
    p.blocks[p.depth] = block
    p.depth += 1
    return true
}

CssCloseBlock :: (p: *CssParser) {
    p.depth -= 1
    p.layer = p.blocks[p.depth].outer_layer
}

CssInRoot :: (p: *CssParser) -> bool {
    return p.depth > 0 && p.blocks[p.depth - 1].kind == CssBlockRoot
}

CssLayerIndex :: (p: *CssParser, name: CssName) -> s32 {
    for index: cast(s32)0..p.layer_count - 1 {
        if CssNameEqualsName(p.layer_names[index], name) { return index }
    }
    if p.layer_count >= 12 {
        CssFail(p, "more than 12 layers")
        return -1
    }
    p.layer_names[p.layer_count] = name
    p.layer_count += 1
    return p.layer_count - 1
}

CssReadLayerName :: (p: *CssParser) -> CssName {
    CssSkipSpace(p)
    name: CssName
    if CssFailed(p) { return name }
    name = CssReadName(p)
    if CssFailed(p) { return name }
    if name.length == 0 {
        CssFail(p, "expected a layer name")
        return name
    }
    if CssAtByte(p, #char ".") {
        CssFail(p, "nested layer names are outside Kryon CSS")
    }
    return name
}

// '@layer a, b;' orders layers; '@layer a { ... }' puts rules in one.
CssReadLayer :: (p: *CssParser) {
    name: CssName = CssReadLayerName(p)
    if CssFailed(p) { return }
    index: s32 = CssLayerIndex(p, name)
    if index < 0 { return }
    CssSkipSpace(p)
    if CssFailed(p) { return }
    if CssAtByte(p, #char "{") {
        p.imports_open = false
        CssAdvance(p, 1)
        if !CssOpenBlock(p, CssBlockLayer, CssCurrentCondition(p), 0, 0) { return }
        p.layer = index
        return
    }
    while CssAtByte(p, #char ",") {
        CssAdvance(p, 1)
        next: CssName = CssReadLayerName(p)
        if CssFailed(p) { return }
        if CssLayerIndex(p, next) < 0 { return }
        CssSkipSpace(p)
        if CssFailed(p) { return }
    }
    unused CssExpect(p, #char ";", "expected ';' or '{' after the layer name")
}

CssReadMedia :: (p: *CssParser) {
    CssSkipSpace(p)
    if CssFailed(p) { return }
    start: s32 = p.cursor.pos
    condition: CssCondition = CssReadMediaQuery(p)
    if CssFailed(p) { return }
    length: s32 = p.cursor.pos - start
    while length > 0 && CssIsSpace(p.cursor.source[start + length - 1]) { length -= 1 }
    combined: CssCondition = CssConditionAnd(p, CssCurrentCondition(p), condition)
    if CssFailed(p) { return }
    if CssCollectIssues(p) {
        for index: cast(s32)0..condition.count - 1 {
            branch: *CssBranch = *condition.branches[index]
            if branch.viewport_count != branch.width_count {
                CssReportIssue(p, p.statement_origin, CssIssueKind.AtRule, "@media",
                    "media condition is evaluated only by the browser", true)
                break
            }
        }
    }
    CssAdvance(p, 1)
    p.imports_open = false
    unused CssOpenBlock(p, CssBlockMedia, combined, start, length)
}

// Skip a balanced block body after '{', strings and comments included.
CssSkipBody :: (p: *CssParser) {
    depth: s32 = 1
    while depth > 0 {
        CssSkipSpace(p)
        if CssFailed(p) { return }
        if CssAtEnd(p) {
            CssFail(p, "expected '}'")
            return
        }
        byte: u8 = CssPeek(p, 0)
        if byte == #char "\"" || byte == #char "'" {
            unused CssReadString(p)
            if CssFailed(p) { return }
            continue
        }
        if byte == #char "{" { depth += 1 }
        if byte == #char "}" { depth -= 1 }
        CssAdvance(p, 1)
    }
}

CssReadImport :: (p: *CssParser) -> bool {
    if !p.imports_open || p.depth > 0 {
        CssFail(p, "@import must come before every other rule")
        return false
    }
    CssSkipSpace(p)
    if CssFailed(p) { return false }
    target: CssName
    if CssAtFunction(p, "url") {
        CssSkipSpace(p)
        if CssFailed(p) { return false }
        if CssAtByte(p, #char "\"") || CssAtByte(p, #char "'") {
            span: CssStringSpan = CssReadString(p)
            if !span.ok { return false }
            if span.length > 64 {
                CssFail(p, "import target longer than 64 bytes")
                return false
            }
            target = CssMakeName(p.cursor.source[span.start:span.start + span.length])
        } else {
            start: s32 = p.cursor.pos
            while !CssAtEnd(p) && CssPeek(p, 0) != #char ")" && !CssIsSpace(CssPeek(p, 0)) &&
                CssPeek(p, 0) != #char ";" {
                CssAdvance(p, 1)
            }
            if p.cursor.pos - start > 64 {
                CssFail(p, "import target longer than 64 bytes")
                return false
            }
            target = CssMakeName(p.cursor.source[start:p.cursor.pos])
        }
        if !CssCloseFunction(p, "url") { return false }
    } else if CssAtByte(p, #char "\"") || CssAtByte(p, #char "'") {
        span: CssStringSpan = CssReadString(p)
        if !span.ok { return false }
        if span.length > 64 {
            CssFail(p, "import target longer than 64 bytes")
            return false
        }
        target = CssMakeName(p.cursor.source[span.start:span.start + span.length])
    } else {
        CssFail(p, "expected a quoted import target")
        return false
    }
    if target.length == 0 {
        CssFail(p, "empty import target")
        return false
    }
    if !CssExpect(p, #char ";", "expected ';' after @import; layer() and media lists are outside Kryon CSS") {
        return false
    }
    p.pending_import = target
    p.status = cast(s32)CssStatusNeedImport
    return true
}

// An at-rule with the cursor on '@'. Returns true when it yields an item.
CssReadAtRule :: (p: *CssParser) -> bool {
    start: s32 = p.cursor.pos
    CssAdvance(p, 1)
    keyword: CssName = CssReadName(p)
    if CssFailed(p) { return false }
    if keyword.length == 0 {
        CssFail(p, "expected an at-rule name")
        return false
    }
    if CssNameEquals(keyword, "import") { return CssReadImport(p) }
    if CssNameEquals(keyword, "layer") {
        CssReadLayer(p)
        return false
    }
    if CssNameEquals(keyword, "media") {
        CssReadMedia(p)
        return false
    }
    if CssNameEquals(keyword, "charset") {
        CssSkipSpace(p)
        span: CssStringSpan = CssReadString(p)
        if CssFailed(p) { return false }
        if !span.ok || !CssNameEquals(CssMakeName(p.cursor.source[span.start:span.start + span.length]), "utf-8") {
            CssFail(p, "Kryon CSS sheets are UTF-8")
            return false
        }
        unused CssExpect(p, #char ";", "expected ';' after @charset")
        return false
    }
    if CssNameEquals(keyword, "keyframes") {
        p.imports_open = false
        CssSkipSpace(p)
        if CssFailed(p) { return false }
        name: CssName = CssReadName(p)
        if CssFailed(p) { return false }
        if name.length == 0 {
            CssFail(p, "expected a keyframes name")
            return false
        }
        if !CssExpect(p, #char "{", "expected '{' after the keyframes name") { return false }
        body: CssCursor = p.cursor
        CssSkipBody(p)
        if CssFailed(p) { return false }
        end: CssCursor = p.cursor
        p.cursor = body
        p.cursor.source = body.source[:end.pos]
        p.keyframes = CssReadKeyframes(p, name)
        if CssCollectIssues(p) && p.keyframes.unsupported && p.keyframes.count == 0 {
            CssReportFailure(p, p.statement_origin, CssIssueKind.AtRule, "@keyframes", true)
        }
        p.cursor = end
        CssClearFailure(p)
        p.layer_of_rule = p.layer
        p.raw_start = start
        p.raw_length = p.cursor.pos - start
        p.rule_condition = CssCurrentCondition(p)
        p.rule_block = p.depth - 1
        if p.rule_condition.never { return false }
        p.status = cast(s32)CssStatusKeyframes
        return true
    }
    if CssNameEquals(keyword, "pack") || CssNameEquals(keyword, "theme") ||
        CssNameEquals(keyword, "env") || CssNameEquals(keyword, "variant") ||
        CssNameEquals(keyword, "version") {
        CssFailName(p, "KSS directive", keyword, "; convert the sheet before loading")
        return false
    }
    CssFailName(p, "at-rule", keyword, " is outside Kryon CSS")
    return false
}

// Adds a nested rule's own parts to a parent selector: each part may only
// add what the parent leaves open, so the result is one flat compound.
CssMergeSelector :: (p: *CssParser, target: *CssPendingSelector, part: CssPendingSelector) -> bool {
    a := *target.selector
    b := part.selector
    clash := (b.class_name != 0 && a.class_name != 0 && a.class_name != b.class_name) ||
        (b.id != 0 && a.id != 0 && a.id != b.id)
    if b.class_name != 0 { a.class_name = b.class_name }
    if b.id != 0 { a.id = b.id }
    fields: [8]*s32 = .[*a.role, *a.tone, *a.emphasis, *a.size, *a.state, *a.validation, *a.orientation, *a.placement]
    values: [8]s32 = .[b.role, b.tone, b.emphasis, b.size, b.state, b.validation, b.orientation, b.placement]
    for index: 0..7 {
        if values[index] == StyleAny() { continue }
        field := fields[index]
        if field.* != StyleAny() && field.* != values[index] { clash = true }
        <<field = values[index]
    }
    if part.state != StyleStateAny() {
        if target.state != StyleStateAny() && target.state != part.state { clash = true }
        target.state = part.state
    }
    if b.context != 0 {
        if (b.not_class != 0 && a.not_class != 0 && a.not_class != b.not_class) ||
            (b.not_state != 0 && a.not_state != 0 && a.not_state != b.not_state) { clash = true }
        a.context |= b.context
        if b.not_class != 0 { a.not_class = b.not_class }
        if b.not_state != 0 { a.not_state = b.not_state }
    }
    if clash {
        CssFail(p, "a nested & rule repeats a class, id, attribute or state of its parent with another value")
        return false
    }
    return true
}

// From after '{' past the matching '}', over strings and comments.
CssSkipBlock :: (p: *CssParser) -> bool {
    depth: s32 = 1
    while !CssAtEnd(p) {
        byte := p.cursor.source[p.cursor.pos]
        if byte == #char "\"" || byte == #char "'" {
            span := CssReadString(p)
            if !span.ok { return false }
            continue
        }
        if byte == #char "/" && CssPeek(p, 1) == #char "*" {
            CssSkipSpace(p)
            if CssFailed(p) { return false }
            continue
        }
        CssAdvance(p, 1)
        if byte == #char "{" { depth += 1 }
        if byte == #char "}" {
            depth -= 1
            if depth == 0 { return true }
        }
    }
    CssFail(p, "expected '}' to close the nested rule")
    return false
}

// `&:hover { }`, `&.active { }`, `&#save { }` or `&[tone=Accent] { }` inside a
// rule: kept with the parent's selectors and read once the parent yields.
CssReadNestedRule :: (p: *CssParser) -> bool {
    if p.nested_count >= 4 {
        CssFail(p, "more than 4 nested rules in one rule")
        return false
    }
    CssAdvance(p, 1)
    part: CssPendingSelector
    part.selector = StyleDefaultSelector()
    part.state = StyleStateAny()
    part.suffix_start = p.cursor.pos
    parts := CssReadSelectorParts(p, *part)
    if parts < 0 { return false }
    part.suffix_length = p.cursor.pos - part.suffix_start
    if parts == 0 || !CssExpect(p, #char "{",
        "nest as &:state, &.class, &#id or &[attribute] { }; write a combinator such as '.card .title' at the top level") {
        if !CssFailed(p) {
            CssFail(p, "nest as &:state, &.class, &#id or &[attribute] { }; write a combinator such as '.card .title' at the top level")
        }
        return false
    }
    nested := *p.nested[p.nested_count]
    nested.count = 0
    for index: cast(s32)0..p.selector_count - 1 {
        merged := p.selectors[index]
        if !CssMergeSelector(p, *merged, part) { return false }
        merged.suffix_start = part.suffix_start
        merged.suffix_length = part.suffix_length
        nested.selectors[nested.count] = merged
        nested.count += 1
    }
    nested.body = p.cursor
    if !CssSkipBlock(p) { return false }
    p.nested_count += 1
    return true
}

// The next nested rule of the rule just yielded: its selectors and body.
CssStartNested :: (p: *CssParser) -> bool {
    nested := p.nested[p.nested_next]
    if p.nested_next == 0 { p.nested_resume = p.cursor }
    p.nested_next += 1
    for index: cast(s32)0..nested.count - 1 { p.selectors[index] = nested.selectors[index] }
    p.selector_count = nested.count
    p.selector_next = 0
    p.cursor = nested.body
    p.in_nested = true
    ok := CssReadRuleBody(p)
    p.in_nested = false
    if p.nested_next >= p.nested_count { p.cursor = p.nested_resume }
    return ok
}

// A rule body after '{': declarations up to '}'.
CssReadRuleBody :: (p: *CssParser) -> bool {
    p.template = StyleData.{}
    p.flex_template = StyleFlexData.{}
    p.box_template = StyleBoxData.{}
    p.motion = CssRuleMotion.{}
    p.rule_ref_count = 0
    p.rule_expr_count = 0
    p.declaration_count = 0
    p.rule_span.body_start = p.cursor.pos
    collect: bool = CssCollectIssues(p)
    while true {
        CssSkipSpace(p)
        if CssFailed(p) { return false }
        if CssAtEnd(p) {
            CssFail(p, "expected '}' to close the rule")
            return false
        }
        if CssAtByte(p, #char "}") {
            p.rule_span.body_length = p.cursor.pos - p.rule_span.body_start
            CssAdvance(p, 1)
            return true
        }
        if CssAtByte(p, #char ";") {
            CssAdvance(p, 1)
            continue
        }
        origin: CssCursor = p.cursor
        if CssAtByte(p, #char "&") && !p.in_nested {
            if CssReadNestedRule(p) { continue }
            if CssRecoverItem(p, origin, CssIssueKind.Selector) { continue }
            return false
        }
        if CssAtByte(p, #char "{") || CssAtByte(p, #char "@") || CssAtByte(p, #char "&") ||
            CssAtByte(p, #char ".") || CssAtByte(p, #char "#") || CssAtByte(p, #char "[") ||
            CssAtByte(p, #char "*") || CssAtByte(p, #char ">") || CssAtByte(p, #char ":") {
            CssFail(p, "nested rules are outside Kryon CSS")
            kind: CssIssueKind = ifx CssAtByte(p, #char "@") then CssIssueKind.AtRule else CssIssueKind.Selector
            if CssRecoverItem(p, origin, kind) { continue }
            return false
        }
        head: CssDeclarationResult = CssReadDeclarationHead(p)
        if !head.ok {
            if CssRecoverItem(p, origin, CssIssueKind.Declaration) { continue }
            return false
        }
        previous: StyleData
        previous_flex: StyleFlexData
        previous_box: StyleBoxData
        motion: CssRuleMotion
        refs: [24]CssLocalRef
        ref_count: s32 = p.rule_ref_count
        exprs: [16]CssRuleExpr
        expr_count: s32 = p.rule_expr_count
        name_count: s32 = p.name_count
        if collect {
            previous = p.template
            previous_flex = p.flex_template
            previous_box = p.box_template
            motion = p.motion
            for index: cast(s32)0..ref_count - 1 { refs[index] = p.rule_refs[index] }
            for index: cast(s32)0..expr_count - 1 { exprs[index] = p.rule_exprs[index] }
        }
        scope: s32 = CssApplyProperty(p, head.name, head.end)
        if scope >= 0 {
            CssRecordDeclaration(p, p.pending_name_start, p.pending_name_length,
                p.pending_value_start, p.pending_value_length, scope)
        }
        if scope < 0 || CssFailed(p) {
            if !collect { return false }
            CssReportFailure(p, origin, CssIssueKind.Declaration, TextView(head.name.bytes[:head.name.length]))
            p.template = previous
            p.flex_template = previous_flex
            p.box_template = previous_box
            p.motion = motion
            p.rule_ref_count = ref_count
            p.name_count = name_count
            for index: cast(s32)0..ref_count - 1 { p.rule_refs[index] = refs[index] }
            p.rule_expr_count = expr_count
            for index: cast(s32)0..expr_count - 1 { p.rule_exprs[index] = exprs[index] }
            CssClearFailure(p)
        } else if collect && scope == CssScopeWeb {
            CssReportIssue(p, origin, CssIssueKind.Declaration, TextView(head.name.bytes[:head.name.length]),
                "declaration is applied only by the browser", true)
        }
        CssFinishDeclaration(p)
    }
    return false
}

CssYieldSelector :: (p: *CssParser) {
    pending: CssPendingSelector = p.selectors[p.selector_next]
    p.rule.selector = pending.selector
    p.rule.state = pending.state
    p.rule.layer = p.layer_of_rule
    p.rule.order = p.rule_total
    p.rule.style = p.template
    p.rule.flex = p.flex_template
    p.rule.box = p.box_template
    p.rule_total += 1
    p.selector_next += 1
    p.status = cast(s32)CssStatusRule
}

// One custom property in :root, with the cursor on its name.
CssReadDefinitionItem :: (p: *CssParser) -> bool {
    line: s32 = p.cursor.line
    column: s32 = p.cursor.column
    head: CssDeclarationResult = CssReadDeclarationHead(p)
    if !head.ok { return false }
    if !head.custom {
        CssFailName(p, ":root holds only custom properties, not", head.name, "")
        return false
    }
    token: CssToken = CssReadDefinition(p, head.end)
    if CssFailed(p) { return false }
    CssFinishDeclaration(p)
    bare: CssName = CssPropertyName(head.name)
    index: s32 = CssNameIndex(p, bare)
    if index < 0 { return false }
    token.name = bare
    token.file = p.cursor.file
    token.line = line
    token.column = column
    p.definition = token
    p.definition_index = index
    p.rule_condition = CssCurrentCondition(p)
    p.rule_block = p.depth - 1
    if p.rule_condition.never { return false }
    p.status = cast(s32)CssStatusProperty
    return true
}

CssPopImport :: (p: *CssParser) {
    p.import_depth -= 1
    p.cursor = p.imports[p.import_depth].outer
    p.imports_open = p.imports[p.import_depth].outer_imports_open
}

// One step. Read p.status after each call.
#program_export
CssStep :: (p: *CssParser) -> s32 {
    if p.status == cast(s32)CssStatusError || p.status == cast(s32)CssStatusDone { return p.status }
    if p.status == cast(s32)CssStatusNeedImport {
        CssFail(p, "the host did not answer @import")
        return p.status
    }
    p.status = cast(s32)CssStatusContinue
    if p.selector_next < p.selector_count {
        CssYieldSelector(p)
        return p.status
    }
    if p.nested_next < p.nested_count {
        if !CssStartNested(p) { return p.status }
        CssYieldSelector(p)
        return p.status
    }
    p.selector_count = 0
    p.selector_next = 0
    p.nested_count = 0
    p.nested_next = 0
    while true {
        CssSkipSpace(p)
        if CssFailed(p) { return p.status }
        if CssAtEnd(p) {
            if p.depth > 0 {
                CssFail(p, "expected '}' before the end of the sheet")
                return p.status
            }
            if p.import_depth > 0 {
                CssPopImport(p)
                continue
            }
            p.status = cast(s32)CssStatusDone
            return p.status
        }
        origin: CssCursor = p.cursor
        byte: u8 = p.cursor.source[p.cursor.pos]
        if CssInRoot(p) {
            if byte == #char "}" {
                CssAdvance(p, 1)
                CssCloseBlock(p)
                continue
            }
            if byte == #char ";" {
                CssAdvance(p, 1)
                continue
            }
            if CssReadDefinitionItem(p) { return p.status }
            if CssFailed(p) && !CssRecoverItem(p, origin, CssIssueKind.Declaration) { return p.status }
            continue
        }
        if byte == #char "}" {
            if p.depth == 0 {
                CssFail(p, "unexpected '}'")
                if CssRecoverItem(p, origin, CssIssueKind.Stylesheet, "}") { continue }
                return p.status
            }
            CssAdvance(p, 1)
            CssCloseBlock(p)
            continue
        }
        if byte == #char ";" {
            CssFail(p, "unexpected ';'")
            if CssRecoverItem(p, origin, CssIssueKind.Stylesheet, ";") { continue }
            return p.status
        }
        if byte == #char "@" {
            p.statement_origin = origin
            layers: s32 = p.layer_count
            themes: s32 = p.theme_count
            if CssReadAtRule(p) { return p.status }
            if CssFailed(p) {
                if !CssRecoverItem(p, origin, CssIssueKind.AtRule) { return p.status }
                p.layer_count = layers
                p.theme_count = themes
            }
            continue
        }
        p.imports_open = false
        if CssAtRoot(p) {
            CssAdvance(p, 1)
            unused CssOpenBlock(p, CssBlockRoot, CssCurrentCondition(p), 0, 0)
            if CssFailed(p) { return p.status }
            continue
        }
        if CssFailed(p) {
            if CssRecoverItem(p, origin, CssIssueKind.Selector) { continue }
            return p.status
        }
        p.origin.file = p.cursor.file
        p.origin.line = p.cursor.line
        p.origin.column = p.cursor.column
        p.rule_span.file = p.cursor.file
        if !CssReadSelectorList(p) {
            if CssRecoverItem(p, origin, CssIssueKind.Selector) {
                p.selector_count = 0
                continue
            }
            return p.status
        }
        p.rule_span.selector_start = p.selector_start
        p.rule_span.selector_length = p.selector_length
        CssAdvance(p, 1)
        if !CssReadRuleBody(p) { return p.status }
        p.rule_condition = CssCurrentCondition(p)
        p.rule_block = p.depth - 1
        p.layer_of_rule = p.layer
        if p.rule_condition.never {
            p.selector_count = 0
            continue
        }
        CssYieldSelector(p)
        return p.status
    }
    return p.status
}

// Answer a NeedImport with the imported sheet's text.
#program_export
CssProvideImport :: (p: *CssParser, source: string, name: string) {
    if p.status != cast(s32)CssStatusNeedImport {
        CssFail(p, "no @import is waiting")
        return
    }
    p.status = cast(s32)CssStatusContinue
    for index: cast(s32)0..p.import_depth - 1 {
        if CssNameEqualsName(p.imports[index].name, p.pending_import) {
            CssFailName(p, "import cycle through", p.pending_import, "")
            return
        }
    }
    if p.import_depth >= 8 {
        CssFail(p, "imports nested more than 8 deep")
        return
    }
    if p.file_count >= 8 {
        CssFail(p, "more than 8 imported sheets")
        return
    }
    frame: CssImportFrame
    frame.name = p.pending_import
    frame.outer = p.cursor
    frame.outer_imports_open = p.imports_open
    p.imports[p.import_depth] = frame
    p.import_depth += 1
    p.files[p.file_count] = CssCopyFileName(name)
    p.cursor.source = source
    p.cursor.pos = 0
    p.cursor.line = 1
    p.cursor.column = 1
    p.cursor.file = p.file_count
    p.file_count += 1
    p.imports_open = true
}

#program_export
CssFailImport :: (p: *CssParser) {
    if p.status != cast(s32)CssStatusNeedImport {
        CssFail(p, "no @import is waiting")
        return
    }
    p.status = cast(s32)CssStatusContinue
    CssFailName(p, "cannot import", p.pending_import, "")
}

// The waiting import target, copied into `output`.
#program_export
CssPendingImport :: (p: *CssParser, output: []u8) -> string {
    count: s32 = p.pending_import.length
    if count > cast(s32)output.count { count = cast(s32)output.count }
    for index: cast(s32)0..count - 1 { output[index] = p.pending_import.bytes[index] }
    return TextView(output[:count])
}
