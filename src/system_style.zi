// Installs the classic style pack in the desktop's colors, so an application
// looks like the system theme (light or dark) without carrying its own.
#import "kryon/drawing_props"
#import "css_parser"
#import "css_sheet"
#import "style_pack_classic"
#import "kryon/system_theme"
#import "kryon/theme"

// A color between two others; 0 is first and 1 is second.
StyleBlend :: (first: u32, second: u32, amount: float32) -> u32 {
    return CssMix(first, second, amount)
}

// The pack's color tokens, derived from the palette's few roles.
SystemStyleOverrides :: (overrides: *CssOverrides, palette: SystemPalette) {
    background: u32 = palette.background
    text: u32 = palette.text
    CssOverrideColor(overrides, "canvas", background)
    CssOverrideColor(overrides, "text", text)
    CssOverrideColor(overrides, "muted", StyleBlend(text, background, 0.4))
    CssOverrideColor(overrides, "surface", StyleBlend(background, text, 0.05))
    CssOverrideColor(overrides, "card", palette.base)
    CssOverrideColor(overrides, "button", StyleBlend(background, text, 0.10))
    CssOverrideColor(overrides, "button-hover", StyleBlend(background, text, 0.16))
    CssOverrideColor(overrides, "button-pressed", StyleBlend(background, text, 0.04))
    CssOverrideColor(overrides, "button-disabled", background)
    CssOverrideColor(overrides, "border", StyleBlend(background, text, 0.30))
    CssOverrideColor(overrides, "border-soft", StyleBlend(background, text, 0.16))
    CssOverrideColor(overrides, "border-hover", StyleBlend(background, text, 0.55))
    CssOverrideColor(overrides, "border-disabled", StyleBlend(background, text, 0.12))
    CssOverrideColor(overrides, "focus-ring", palette.selected)
    CssOverrideColor(overrides, "outline-border", StyleBlend(background, text, 0.5))
    CssOverrideColor(overrides, "row", StyleBlend(background, text, 0.03))
    CssOverrideColor(overrides, "row-hover", StyleBlend(background, text, 0.07))
    CssOverrideColor(overrides, "row-pressed", StyleBlend(background, text, 0.10))
    CssOverrideColor(overrides, "thumb-ink", cast(u32)0xFFFFFFFF)
    selected: u32 = palette.selected
    CssOverrideColor(overrides, "accent", selected)
    CssOverrideColor(overrides, "accent-end", selected)
    CssOverrideColor(overrides, "accent-hover", StyleBlend(selected, text, 0.15))
    CssOverrideColor(overrides, "accent-pressed", StyleBlend(selected, background, 0.2))
    CssOverrideColor(overrides, "accent-border", StyleBlend(selected, background, 0.35))
    CssOverrideColor(overrides, "accent-ink", palette.selected_text)
    CssOverrideColor(overrides, "accent-soft", StyleBlend(background, selected, 0.22))
    CssOverrideColor(overrides, "accent-soft-hover", StyleBlend(background, selected, 0.30))
    CssOverrideColor(overrides, "accent-soft-pressed", StyleBlend(background, selected, 0.38))
    SystemStyleStatus(overrides, "danger", palette.danger, background, text)
    SystemStyleStatus(overrides, "success", palette.success, background, text)
    SystemStyleStatus(overrides, "warning", palette.warning, background, text)
}

// One status color and the variants the pack derives from it.
SystemStyleStatus :: (overrides: *CssOverrides, name: string, color: u32, background: u32,
    text: u32) {
    if name == "danger" {
        CssOverrideColor(overrides, "danger", color)
        CssOverrideColor(overrides, "danger-hover", StyleBlend(color, text, 0.15))
        CssOverrideColor(overrides, "danger-pressed", StyleBlend(color, background, 0.2))
        CssOverrideColor(overrides, "danger-ink", OnColor(color))
        CssOverrideColor(overrides, "danger-soft", StyleBlend(background, color, 0.2))
        CssOverrideColor(overrides, "danger-soft-hover", StyleBlend(background, color, 0.28))
        CssOverrideColor(overrides, "danger-soft-pressed", StyleBlend(background, color, 0.36))
    } else if name == "success" {
        CssOverrideColor(overrides, "success", color)
        CssOverrideColor(overrides, "success-hover", StyleBlend(color, text, 0.15))
        CssOverrideColor(overrides, "success-pressed", StyleBlend(color, background, 0.2))
        CssOverrideColor(overrides, "success-ink", OnColor(color))
        CssOverrideColor(overrides, "success-soft", StyleBlend(background, color, 0.2))
        CssOverrideColor(overrides, "success-soft-hover", StyleBlend(background, color, 0.28))
        CssOverrideColor(overrides, "success-soft-pressed", StyleBlend(background, color, 0.36))
    } else {
        CssOverrideColor(overrides, "warning", color)
        CssOverrideColor(overrides, "warning-hover", StyleBlend(color, text, 0.15))
        CssOverrideColor(overrides, "warning-pressed", StyleBlend(color, background, 0.2))
        CssOverrideColor(overrides, "warning-ink", OnColor(color))
        CssOverrideColor(overrides, "warning-soft", StyleBlend(background, color, 0.2))
        CssOverrideColor(overrides, "warning-soft-hover", StyleBlend(background, color, 0.28))
        CssOverrideColor(overrides, "warning-soft-pressed", StyleBlend(background, color, 0.36))
    }
}

system_style_sheet: CssSheet;
system_style_overrides: CssOverrides;
system_style_loaded: bool;

// Installs the compiled classic pack with the palette's colors. Returns
// false when it cannot install; the previous style then stays.
#program_export
StyleInstallSystem :: (palette: SystemPalette) -> bool {
    if !system_style_loaded {
        CssSheetReset(*system_style_sheet)
        if !CssSheetLoad(*system_style_sheet, StylePackClassic()) { return false }
        system_style_loaded = true
    }
    environment: CssEnvironment = CssEnvironmentWithNames(CssDefaultEnvironment(),
        ifx palette.dark then "dark" else "light", "", "", "", "")
    system_style_overrides.count = 0
    SystemStyleOverrides(*system_style_overrides, palette)
    return CssSheetInstall(*system_style_sheet, environment, *system_style_overrides)
}
