// Kryon CSS command line tool. Run it from the repository root:
//
//   css_tool export IN.css OUT.css    write browser CSS for the DOM host and
//                                     check the result parses
//   css_tool check [--strict] FILE.css report native CSS issues; imports count as empty
//   css_tool format FILE.css          rewrite a sheet in the standard layout
//   css_tool format-check FILE.css    fail when a sheet is not formatted
//   css_tool pack NAME                compile styles/NAME.css into
//                                     src/style_pack_NAME.zi
//   css_tool pack-file NAME IN.css OUT.zi   compile a standalone pack
//   css_tool pack-check NAME          fail when src/style_pack_NAME.zi is
//                                     not what `pack` would write
//   css_tool properties FILE.md       write the property catalog's table
//                                     between FILE's properties markers
//   css_tool properties-check FILE.md fail when that table is stale
//
// Apps import this package without running its Makefile, so compiled packs
// are committed and `make style-pack-check` keeps them equal to their CSS.
#import "byte_text_linux"
#import "c_string"
#import "file_linux"
#import "std/text_tools"
#import "css_parser"
#import "css_sheet"
#import "css_format"
#import "css_export"
#import "kryon/style"
#import "kryon/style_sheet"
#import "kryon/control_props"

using StyleField;

libc :: #system_library "libc";
RawWrite :: (descriptor: s32, input: *u8, count: u64) -> s64 #foreign libc "write";

source_bytes: [262144]u8;
output_bytes: [1048576]u8;
output_length: s32 = 0;
disk_bytes: [1048576]u8;
sheet: CssSheet;

WriteText :: (descriptor: s32, text: string) {
    chunk: [4096]u8
    at: s32 = 0
    while at < cast(s32)text.count {
        count: s32 = cast(s32)text.count - at
        if count > 4096 { count = 4096 }
        for index: cast(s32)0..count - 1 { chunk[index] = text[at + index] }
        if RawWrite(descriptor, *chunk[0], cast(u64)count) <= 0 { return }
        at += count
    }
}

Fail :: (name: string, message: string) -> s32 {
    WriteText(2, "css_tool: ")
    WriteText(2, name)
    WriteText(2, ": ")
    WriteText(2, message)
    WriteText(2, "\n")
    return 1
}

ReadFile :: (path: string) -> s32 {
    file: FileHandle = OpenRead(path)
    if !file.valid { return -1 }
    read: s64 = ReadAt(file, source_bytes[:], 0)
    CloseFile(file)
    if read < 0 || read >= cast(s64)source_bytes.count { return -1 }
    return cast(s32)read
}

WriteFile :: (path: string, bytes: []u8) -> bool {
    output: FileHandle = OpenReplace(path)
    if !output.valid { return false }
    written: s64 = WriteAt(output, bytes, 0)
    CloseFile(output)
    return written == cast(s64)bytes.count
}

// Imports resolve to empty sheets when only checking syntax.
EmptyImport :: (name: string) -> CssImportAnswer {
    answer: CssImportAnswer
    answer.found = true
    answer.source = ""
    return answer
}

PrintIssue :: (context: *void, issue: CssIssue) {
    output_length = 0
    unused EmitNumber(issue.line)
    unused Emit(":")
    unused EmitNumber(issue.column)
    WriteText(2, issue.path)
    WriteText(2, ":")
    WriteText(2, TextView(output_bytes[:output_length]))
    WriteText(2, ifx issue.web_only then ": web-only " else ": skipped ")
    if issue.kind == CssIssueKind.Declaration { WriteText(2, "declaration") }
    else if issue.kind == CssIssueKind.AtRule { WriteText(2, "at-rule") }
    else if issue.kind == CssIssueKind.Selector { WriteText(2, "selector") }
    else { WriteText(2, "stylesheet") }
    if issue.name.count > 0 {
        WriteText(2, " '")
        WriteText(2, issue.name)
        WriteText(2, "'")
    }
    WriteText(2, ": ")
    WriteText(2, issue.reason)
    WriteText(2, "\n")
}

CheckSheet :: (path: string, source: string, strict: bool) -> s32 {
    CssSheetReset(*sheet)
    diagnostics: CssDiagnostics = .{.report = PrintIssue, .strict = strict}
    return ifx CssSheetParseWithDiagnostics(*sheet, source, path, EmptyImport, diagnostics) then 0 else 1
}

// Generated module text ------------------------------------------------

Emit :: (text: string) -> bool {
    if output_length + cast(s32)text.count > cast(s32)output_bytes.count { return false }
    for index: cast(s32)0..cast(s32)text.count - 1 { output_bytes[output_length + index] = text[index] }
    output_length += cast(s32)text.count
    return true
}

EmitNumber :: (value: s32) -> bool {
    digits: [16]u8
    at: s32 = 16
    magnitude: s32 = value
    if magnitude < 0 {
        if !Emit("-") { return false }
        magnitude = -magnitude
    }
    while true {
        at -= 1
        digits[at] = cast(u8)(48 + magnitude % 10)
        magnitude = magnitude / 10
        if magnitude == 0 { break }
    }
    return Emit(TextView(digits[at:16]))
}

EmitHex :: (value: u32) -> bool {
    digits: [10]u8
    digits[0] = 48
    digits[1] = 120
    hex: string = "0123456789abcdef"
    for index: cast(s32)0..7 {
        digits[2 + index] = hex[cast(s32)((value >> cast(u32)((7 - index) * 4)) & cast(u32)15)]
    }
    return Emit(TextView(digits[:]))
}

// IEEE 754 single bits, computed exactly so every target decodes the same.
FloatBits :: (value: float32) -> u32 {
    v: float64 = cast(float64)value
    if v == 0.0 { return 0 }
    sign: u32 = 0
    if v < 0.0 {
        sign = 0x80000000
        v = -v
    }
    exponent: s32 = 0
    while v >= 2.0 {
        v = v / 2.0
        exponent += 1
    }
    while v < 1.0 {
        v = v * 2.0
        exponent -= 1
    }
    biased: s32 = exponent + 127
    if biased <= 0 { return sign }
    mantissa: u32 = cast(u32)((v - 1.0) * 8388608.0)
    return sign | (cast(u32)biased << cast(u32)23) | mantissa
}

words: [65536]u32;
word_count: s32 = 0;

Word :: (value: u32) {
    if word_count < cast(s32)words.count {
        words[word_count] = value
        word_count += 1
    }
}

SignedWord :: (value: s32) { Word(cast(u32)value) }

// One u32 array from words[0:word_count], at least one element; its _count
// constant is the number of words.
EmitWords :: (name: string, pack: string, per_line: s32) -> bool {
    count: s32 = word_count
    if count == 0 { Word(0) }
    ok: bool = Emit("style_pack_") && Emit(pack) && Emit("_") && Emit(name) && Emit(": [") &&
        EmitNumber(word_count) && Emit("]u32 = .[")
    for index: cast(s32)0..word_count - 1 {
        if index % per_line == 0 { ok = ok && Emit("\n    ") }
        else { ok = ok && Emit(" ") }
        ok = ok && EmitHex(words[index])
        if index + 1 < word_count { ok = ok && Emit(",") }
    }
    ok = ok && Emit("];\nstyle_pack_") && Emit(pack) && Emit("_") && Emit(name) && Emit("_count :: ") &&
        EmitNumber(count) && Emit(";\n\n")
    word_count = 0
    return ok
}

EmitStrings :: (name: string, pack: string, names: []CssName, count: s32) -> bool {
    total: s32 = count
    if total == 0 { total = 1 }
    ok: bool = Emit("style_pack_") && Emit(pack) && Emit("_") && Emit(name) && Emit(": [") &&
        EmitNumber(total) && Emit("]string = .[")
    if count == 0 { ok = ok && Emit("\"\"") }
    for index: cast(s32)0..count - 1 {
        ok = ok && Emit(ifx index == 0 then "\n    \"" else ",\n    \"") &&
            Emit(TextView(names[index].bytes[:names[index].length])) && Emit("\"")
    }
    return ok && Emit("];\nstyle_pack_") && Emit(pack) && Emit("_") && Emit(name) && Emit("_count :: ") &&
        EmitNumber(count) && Emit(";\n\n")
}

typefaces: [CssSheetTypefaceCapacity]CssName;
typeface_count: s32 = 0;

TypefaceIndex :: (name: string) -> s32 {
    if name.count == 0 { return -1 }
    for index: cast(s32)0..typeface_count - 1 {
        if CssNameSame(typefaces[index], CssMakeName(name)) { return index }
    }
    if typeface_count >= CssSheetTypefaceCapacity || name.count > 64 { return -2 }
    typefaces[typeface_count] = CssMakeName(name)
    typeface_count += 1
    return typeface_count - 1
}

title_bytes: [64]u8;
// "material" -> "Material", for StylePackMaterial.
Title :: (name: string) -> string {
    for index: cast(s32)0..cast(s32)name.count - 1 {
        byte: u8 = name[index]
        if index == 0 && byte >= 97 && byte <= 122 { byte = byte - 32 }
        title_bytes[index] = byte
    }
    return TextView(title_bytes[0:name.count])
}

PairWords :: (value: u64) {
    Word(cast(u32)value)
    Word(cast(u32)(value >> cast(u64)32))
}

// CSS numbers are bounded by the lexer and every nonzero one is normal.
DoubleWords :: (value: float64) {
    if value == 0.0 { PairWords(0); return }
    sign: u64 = 0
    scaled: float64 = value
    if scaled < 0.0 {
        sign = cast(u64)1 << cast(u64)63
        scaled = -scaled
    }
    exponent: s32 = 1023
    while scaled >= 2.0 { scaled *= 0.5; exponent += 1 }
    while scaled < 1.0 { scaled *= 2.0; exponent -= 1 }
    PairWords(sign | (cast(u64)exponent << cast(u64)52) | cast(u64)((scaled - 1.0) * 4503599627370496.0))
}

CurveWords :: (curve: CssCurve) {
    Word(FloatBits(curve.x1))
    Word(FloatBits(curve.y1))
    Word(FloatBits(curve.x2))
    Word(FloatBits(curve.y2))
}

EmitMotionTables :: (pack: string) -> bool {
    for index: cast(s32)0..sheet.rule_count - 1 {
        motion: CssRuleMotion = sheet.rules[index].motion
        transition: CssTransition = motion.transition
        animation: CssAnimation = motion.animation
        if !transition.set && !animation.set { continue }
        SignedWord(index)
        flags: u32 = 0
        if transition.set { flags |= 1 }
        if transition.unsupported { flags |= 2 }
        if animation.set { flags |= 4 }
        if animation.unsupported { flags |= 8 }
        Word(flags)
        Word(transition.fields)
        DoubleWords(transition.seconds)
        DoubleWords(transition.delay)
        CurveWords(transition.curve)
        PairWords(animation.key)
        DoubleWords(animation.seconds)
        DoubleWords(animation.delay)
        DoubleWords(animation.iterations)
        CurveWords(animation.curve)
        Word(animation.flags)
    }
    ok: bool = EmitWords("motion", pack, CssCompiledMotionWords)
    for index: cast(s32)0..sheet.keyframes_count - 1 {
        entry: CssSheetKeyframes = sheet.keyframes[index]
        PairWords(entry.key)
        SignedWord(entry.layer)
        SignedWord(entry.condition + 1)
        SignedWord(entry.first)
        SignedWord(entry.count)
        Word(ifx entry.unsupported then cast(u32)1 else cast(u32)0)
    }
    ok = ok && EmitWords("keyframes", pack, CssCompiledKeyframesWords)
    for index: cast(s32)0..sheet.frame_count - 1 {
        frame: CssKeyframe = sheet.frames[index]
        Word(FloatBits(frame.offset))
        Word(frame.style.fields)
        Word(frame.style.background)
        Word(frame.style.foreground)
        Word(frame.style.border)
        Word(FloatBits(frame.style.radius))
        Word(FloatBits(frame.style.border_width))
        Word(FloatBits(frame.style.opacity))
        Word(FloatBits(frame.style.offset_x))
        Word(FloatBits(frame.style.offset_y))
    }
    return ok && EmitWords("frames", pack, CssCompiledFrameWords)
}

PackPart :: (pack: string, part: string) -> bool {
    return Emit("    compiled.") && Emit(part) && Emit(" = style_pack_") && Emit(pack) && Emit("_") &&
        Emit(part) && Emit("[0:style_pack_") && Emit(pack) && Emit("_") && Emit(part) && Emit("_count]\n")
}

GeneratePack :: (pack: string, source: string, canonical: bool = true) -> s32 {
    file: [128]u8
    path: string = Join(file[:], pack, ".css")
    CssSheetReset(*sheet)
    if !CssSheetParse(*sheet, source, path, CssNoImports) {
        text: [256]u8
        return Fail(path, CssSheetDiagnostic(*sheet, text[:]))
    }
    for index: cast(s32)0..sheet.condition_count - 1 {
        for branch: cast(s32)0..sheet.conditions[index].count - 1 {
            query := sheet.conditions[index].branches[branch]
            if query.viewport_count != query.width_count {
                return Fail(path, "packs only support native viewport width queries")
            }
        }
    }
    output_length = 0
    typeface_count = 0
    title: string = Title(pack)
    ok: bool = Emit(ifx canonical then "// Generated from styles/" else "// Generated from ") && Emit(pack) && Emit(".css by tools/css_tool.zi.\n") &&
        Emit(ifx canonical then "// Edit the CSS and run `make style-packs`; do not edit this file.\n" else "// Regenerate this file with css_tool pack-file.\n") &&
        Emit("#import \"css_sheet\"\n\n")
    for index: cast(s32)0..sheet.rule_count - 1 {
        entry: CssSheetRule = sheet.rules[index]
        selector: StyleSelector = entry.rule.selector
        rule_start: s32 = word_count
        SignedWord(selector.kind)
        SignedWord(selector.name)
        SignedWord(selector.class_name)
        SignedWord(selector.id)
        SignedWord(selector.role)
        SignedWord(selector.tone)
        SignedWord(selector.emphasis)
        SignedWord(selector.size)
        SignedWord(selector.state)
        SignedWord(selector.validation)
        SignedWord(selector.orientation)
        SignedWord(selector.placement)
        SignedWord(entry.rule.state)
        SignedWord(entry.rule.layer)
        SignedWord(entry.condition + 1)
        style: StyleData = entry.rule.style
        Word(style.fields)
        Word(style.background)
        Word(style.foreground)
        Word(style.border)
        Word(style.focus)
        Word(style.background_end)
        Word(FloatBits(style.radius))
        Word(FloatBits(style.border_width))
        Word(FloatBits(style.opacity))
        Word(FloatBits(style.padding_x))
        Word(FloatBits(style.padding_y))
        Word(FloatBits(style.gap))
        Word(FloatBits(style.font_size))
        Word(FloatBits(style.icon_size))
        Word(FloatBits(style.offset_x))
        Word(FloatBits(style.offset_y))
        Word(FloatBits(style.letter_spacing))
        SignedWord(cast(s32)style.material)
        typeface: s32 = TypefaceIndex(style.typeface)
        if typeface < -1 { return Fail(path, "more than 16 typefaces") }
        SignedWord(typeface + 1)
        Word(FloatBits(style.min_height))
        Word(FloatBits(style.line_height))
        SignedWord(cast(s32)style.font_role)
        SignedWord(cast(s32)style.elevation)
        Word(FloatBits(style.motion_duration))
        Word(FloatBits(style.motion_multiplier))
        SignedWord(cast(s32)style.motion_easing)
        Word(ifx style.motion_reduced then cast(u32)1 else cast(u32)0)
        Word(FloatBits(style.row_gap))
        Word(FloatBits(style.column_gap))
        SignedWord(style.font_weight)
        SignedWord(cast(s32)style.font_style)
        SignedWord(cast(s32)style.line_height_unit)
        Word(FloatBits(style.width))
        Word(FloatBits(style.height))
        SignedWord(style.grid_tracks)
        flex := entry.rule.flex
        Word(flex.fields)
        SignedWord(flex.direction)
        Word(ifx flex.wrap then cast(u32)1 else cast(u32)0)
        SignedWord(flex.justify_content)
        SignedWord(flex.align_items)
        Word(FloatBits(flex.basis))
        Word(FloatBits(flex.grow))
        Word(FloatBits(flex.shrink))
        SignedWord(flex.align_self)
        box := entry.rule.box
        Word(box.fields)
        Word(FloatBits(box.min_width))
        Word(FloatBits(box.max_width))
        Word(FloatBits(box.max_height))
        Word(ifx box.clip_children then cast(u32)1 else cast(u32)0)
        SignedWord(box.text_align)
        Word(FloatBits(box.margin_top))
        Word(FloatBits(box.margin_right))
        Word(FloatBits(box.margin_bottom))
        Word(FloatBits(box.margin_left))
        Word(style.percent)
        Word(flex.percent)
        Word(box.percent)
        for width: box.border_widths { Word(FloatBits(width)) }
        for color: box.border_colors { Word(color) }
        Word(FloatBits(box.outline_width))
        Word(FloatBits(box.outline_offset))
        Word(selector.context)
        SignedWord(selector.ancestor_class)
        SignedWord(selector.ancestor_id)
        SignedWord(selector.not_class)
        SignedWord(selector.not_state)
        Word(FloatBits(box.gradient_dx))
        Word(FloatBits(box.gradient_dy))
        SignedWord(box.gradient_corner)
        SignedWord(box.gradient_count)
        for stop: box.gradient_stops { Word(FloatBits(stop)) }
        for color: box.gradient_colors { Word(color) }
        for part: box.transform { Word(FloatBits(part)) }
        Word(FloatBits(box.rotate))
        for part: box.scale { Word(FloatBits(part)) }
        for part: box.transform_origin { Word(FloatBits(part)) }
        Word(FloatBits(box.transform_seconds))
        for part: box.transform_timing { Word(cast(u32)part) }
        if word_count - rule_start != CssRuleWords || word_count + CssRuleMaskWords > cast(s32)words.count {
            return Fail(path, "the rule layout does not match CssRuleWords")
        }
        dense: [CssRuleWords]u32
        for word: cast(s32)0..CssRuleWords - 1 { dense[word] = words[rule_start + word] }
        word_count = rule_start + CssPackRule(dense[:], words[rule_start:rule_start + CssRuleMaskWords + CssRuleWords])
    }
    ok = ok && EmitWords("rules", pack, 16)
    for index: cast(s32)0..sheet.ref_count - 1 {
        ref: CssSheetRef = sheet.refs[index]
        SignedWord(ref.rule)
        SignedWord(ref.name)
        Word(cast(u32)ref.field | (ifx ref.fallback then cast(u32)256 else cast(u32)0) |
            (cast(u32)ref.alternate << cast(u32)16))
        SignedWord(ref.line)
    }
    ok = ok && EmitWords("refs", pack, CssCompiledRefWords * 2)
    for index: cast(s32)0..sheet.expr_count - 1 {
        entry := sheet.exprs[index]
        SignedWord(entry.rule)
        SignedWord(entry.field)
        Word((ifx entry.expr.has_low then cast(u32)1 else cast(u32)0) |
            (ifx entry.expr.has_high then cast(u32)2 else cast(u32)0))
        forms: [3]CssLinear = .[entry.expr.value, entry.expr.low, entry.expr.high]
        for form: forms {
            Word(FloatBits(cast(float32)form.px))
            Word(FloatBits(cast(float32)form.vw))
            Word(FloatBits(cast(float32)form.vh))
        }
    }
    ok = ok && EmitWords("exprs", pack, CssCompiledExprWords)
    for index: cast(s32)0..sheet.definition_count - 1 {
        definition: CssSheetDefinition = sheet.definitions[index]
        SignedWord(definition.name)
        SignedWord(definition.condition + 1)
        SignedWord(definition.kind)
        Word(definition.color)
        Word(FloatBits(definition.number))
        SignedWord(definition.material)
        SignedWord(definition.alias + 1)
        SignedWord(definition.line)
    }
    ok = ok && EmitWords("definitions", pack, CssCompiledDefinitionWords)
    for index: cast(s32)0..sheet.condition_count - 1 {
        condition: CssCondition = sheet.conditions[index]
        SignedWord(condition.count)
        Word(ifx condition.never then cast(u32)1 else cast(u32)0)
        for branch: cast(s32)0..3 {
            mask: u32 = condition.branches[branch].mask
            if (mask & CssMotionBits) == CssMotionBits { mask &= ~CssMotionBits }
            Word(mask)
            SignedWord(condition.branches[branch].theme + 1)
        }
        for branch: cast(s32)0..3 {
            query := condition.branches[branch]
            SignedWord(query.width_count)
            Word(FloatBits(query.min_width))
            Word(FloatBits(query.max_width))
        }
    }
    ok = ok && EmitWords("conditions", pack, CssConditionWords)
    ok = ok && EmitStrings("names", pack, sheet.names[:], sheet.name_count) &&
        EmitStrings("themes", pack, sheet.themes[:], sheet.theme_count) &&
        EmitStrings("layers", pack, sheet.layers[:], sheet.layer_count) &&
        EmitStrings("typefaces", pack, typefaces[:], typeface_count)
    has_motion: bool = sheet.keyframes_count > 0
    for index: cast(s32)0..sheet.rule_count - 1 {
        if sheet.rules[index].motion.transition.set || sheet.rules[index].motion.animation.set { has_motion = true }
    }
    if has_motion { ok = ok && EmitMotionTables(pack) }
    ok = ok && Emit("// The ") && Emit(pack) && Emit(" pack, compiled: load it with CssSheetLoad.\n") &&
        Emit("#program_export\nStylePack") && Emit(title) && Emit(" :: () -> CssCompiledSheet {\n") &&
        Emit("    compiled: CssCompiledSheet\n") &&
        Emit("    compiled.rule_words = ") && EmitNumber(CssRuleWords) && Emit("\n") &&
        Emit("    compiled.rule_count = ") && EmitNumber(sheet.rule_count) && Emit("\n")
    for part: css_tool_parts {
        ok = ok && PackPart(pack, part)
    }
    if has_motion { ok = ok && PackPart(pack, "motion") && PackPart(pack, "keyframes") && PackPart(pack, "frames") }
    ok = ok && Emit("    compiled.file = \"") && Emit(path) && Emit("\"\n    return compiled\n}\n")
    if !ok { return Fail(path, "the generated module is too large") }
    return 0
}

css_tool_parts: [9]string = .["rules", "refs", "exprs", "definitions", "conditions", "names", "themes", "layers", "typefaces"];

join_bytes: [512]u8;
Join :: (output: []u8, first: string, second: string) -> string {
    count: s32 = 0
    for index: cast(s32)0..cast(s32)first.count - 1 {
        if count < cast(s32)output.count { output[count] = first[index]; count += 1 }
    }
    for index: cast(s32)0..cast(s32)second.count - 1 {
        if count < cast(s32)output.count { output[count] = second[index]; count += 1 }
    }
    return TextView(output[:count])
}

ValidName :: (name: string) -> bool {
    if name.count == 0 || name.count > 32 { return false }
    for byte: name {
        if !((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95) { return false }
    }
    return true
}

PropertiesStart :: "<!-- properties:start -->\n"
PropertiesEnd :: "<!-- properties:end -->"

// FILE with the property catalog's table between its markers, written to
// output_bytes; false when FILE has no markers.
PropertiesInto :: (file: string) -> bool {
    start := cast(s32)TextFind(file, PropertiesStart, 0)
    if start < 0 { return false }
    head := start + cast(s32)PropertiesStart.count
    end := cast(s32)TextFind(file, PropertiesEnd, head)
    if end < 0 { return false }
    output_length = 0
    ok := Emit(file[0:head]) && Emit("| Property | Applies to | Example | Values |\n| --- | --- | --- | --- |\n")
    for index: cast(s32)0..CssCatalogCount - 1 {
        entry := CssCatalogEntryAt(index)
        ok = ok && Emit("| `") && Emit(entry.name) && Emit("` | `") && Emit(entry.target) && Emit("` | `") &&
            Emit(entry.sample) && Emit("` | ") && Emit(entry.values) && Emit(" |\n")
    }
    return ok && Emit(file[end:])
}

Argument :: (argv: **s8, index: s32) -> string {
    return TextFromCString(cast(*u8)argv[index])
}

#program_export
main :: (argc: s32, argv: **s8) -> s32 {
    if argc < 3 {
        WriteText(2, "usage: css_tool export IN.css OUT.css | check [--strict] FILE.css | format FILE.css | format-check FILE.css | pack NAME | pack-file NAME IN.css OUT.zi | pack-check NAME | properties FILE.md | properties-check FILE.md\n")
        return 2
    }
    mode: string = Argument(argv, 1)
    if mode == "properties" || mode == "properties-check" {
        path: string = Argument(argv, 2)
        count: s32 = ReadFile(path)
        if count < 0 { return Fail(path, "cannot read") }
        source: string = TextView(source_bytes[:count])
        if !PropertiesInto(source) { return Fail(path, "has no property table markers") }
        if TextView(output_bytes[:output_length]) == source { return 0 }
        if mode == "properties-check" { return Fail(path, "property table is stale; run `css_tool properties`") }
        if !WriteFile(path, output_bytes[:output_length]) { return Fail(path, "cannot write") }
        return 0
    }
    if mode == "check" {
        strict: bool = Argument(argv, 2) == "--strict"
        index: s32 = ifx strict then 3 else 2
        if argc != index + 1 {
            WriteText(2, "usage: css_tool check [--strict] FILE.css\n")
            return 2
        }
        path: string = Argument(argv, index)
        count: s32 = ReadFile(path)
        if count < 0 { return Fail(path, "cannot read") }
        return CheckSheet(path, TextView(source_bytes[:count]), strict)
    }
    if mode == "format" || mode == "format-check" {
        path: string = Argument(argv, 2)
        count: s32 = ReadFile(path)
        if count < 0 { return Fail(path, "cannot read") }
        source: string = TextView(source_bytes[:count])
        result: CssFormatResult = CssFormat(source, output_bytes[:])
        if !result.ok { return Fail(path, TextView(result.diagnostic[:result.diagnostic_length])) }
        formatted: string = TextView(output_bytes[:result.count])
        if formatted == source { return 0 }
        if mode == "format-check" { return Fail(path, "not formatted; run `css_tool format`") }
        if !WriteFile(path, output_bytes[:result.count]) { return Fail(path, "cannot write") }
        WriteText(1, path)
        WriteText(1, "\n")
        return 0
    }
    if mode == "export" {
        if argc != 4 { return Fail("export", "usage: css_tool export IN.css OUT.css") }
        input: string = Argument(argv, 2)
        target: string = Argument(argv, 3)
        count: s32 = ReadFile(input)
        if count < 0 { return Fail(input, "cannot read") }
        source: string = TextView(source_bytes[:count])
        result: CSSExport = ExportCSS(source, input, CssDefaultEnvironment(), output_bytes[:])
        if !result.ok {
            return Fail(input, TextView(result.error[:result.error_length]))
        }
        if !WriteFile(target, output_bytes[:result.count]) { return Fail(target, "cannot write") }
        WriteText(1, target)
        WriteText(1, "\n")
        return 0
    }
    if mode == "pack-file" {
        if argc != 5 { return Fail(mode, "usage: css_tool pack-file NAME IN.css OUT.zi") }
        pack: string = Argument(argv, 2)
        if !ValidName(pack) { return Fail(pack, "pack names are lower case letters, digits and '_'") }
        input: string = Argument(argv, 3)
        target: string = Argument(argv, 4)
        count: s32 = ReadFile(input)
        if count < 0 { return Fail(input, "cannot read the pack") }
        status: s32 = GeneratePack(pack, TextView(source_bytes[:count]), false)
        if status != 0 { return status }
        if !WriteFile(target, output_bytes[:output_length]) { return Fail(target, "cannot write") }
        return 0
    }
    if mode == "pack" || mode == "pack-check" {
        pack: string = Argument(argv, 2)
        if !ValidName(pack) { return Fail(pack, "pack names are lower case letters, digits and '_'") }
        path_bytes: [128]u8
        tail: [64]u8
        css_path: string = Join(path_bytes[:], "styles/", Join(tail[:], pack, ".css"))
        count: s32 = ReadFile(css_path)
        if count <= 0 { return Fail(css_path, "cannot read the pack") }
        source: string = TextView(source_bytes[:count])
        status: s32 = GeneratePack(pack, source)
        if status != 0 { return status }
        module: string = TextView(output_bytes[:output_length])
        module_path_bytes: [128]u8
        module_tail: [64]u8
        module_path: string = Join(module_path_bytes[:], "src/style_pack_", Join(module_tail[:], pack, ".zi"))
        if mode == "pack-check" {
            disk: FileHandle = OpenRead(module_path)
            if !disk.valid { return Fail(module_path, "missing; run `make style-packs`") }
            read: s64 = ReadAt(disk, disk_bytes[:], 0)
            CloseFile(disk)
            if read != cast(s64)output_length || TextView(disk_bytes[0:cast(s32)read]) != module {
                return Fail(module_path, "differs from its CSS; run `make style-packs`")
            }
            return 0
        }
        if !WriteFile(module_path, output_bytes[:output_length]) { return Fail(module_path, "cannot write") }
        WriteText(1, module_path)
        WriteText(1, "\n")
        return 0
    }
    return Fail(mode, "unknown command")
}
